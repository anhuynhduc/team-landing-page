---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';

const posts = [
  { slug: 'table-of-contents-la-gi',         title: 'Table of Contents là gì? Hướng dẫn tạo mục lục cho website',           date: '27/02/2026', cat: 'SEO',         icon: '📝', color: '#e8f4fd', readTime: '5 phút' },
  { slug: 'elementor-la-gi',                  title: 'Elementor là gì? Cách cài đặt và cấu hình cho người mới',               date: '20/02/2026', cat: 'Website',     icon: '⚙️', color: '#e8f9f7', readTime: '7 phút' },
  { slug: 'google-knowledge-graph-la-gi',     title: 'Google Knowledge Graph là gì? Hướng dẫn tối ưu chi tiết',              date: '16/02/2026', cat: 'SEO',         icon: '🔍', color: '#fef9e7', readTime: '8 phút' },
  { slug: 'top-cong-ty-seo-viet-nam',         title: 'Top 10+ công ty SEO uy tín, chuyên nghiệp Việt Nam',                   date: '06/02/2026', cat: 'SEO',         icon: '📈', color: '#f5f0ff', readTime: '10 phút' },
  { slug: 'link-building-la-gi',              title: 'Link Building là gì? Chiến lược xây dựng backlink hiệu quả 2026',      date: '30/01/2026', cat: 'SEO',         icon: '🔗', color: '#fdecea', readTime: '9 phút' },
  { slug: 'schema-markup-la-gi',              title: 'Schema Markup là gì? Hướng dẫn triển khai từ A đến Z',                 date: '15/01/2026', cat: 'SEO',         icon: '🗂️', color: '#f0f4ff', readTime: '11 phút' },
  { slug: 'thiet-ke-ux-ui-la-gi',             title: 'UI/UX Design là gì? Nguyên tắc thiết kế trải nghiệm người dùng',       date: '10/01/2026', cat: 'Design',      icon: '🎨', color: '#fff8e8', readTime: '6 phút' },
  { slug: 'astro-framework-la-gi',            title: 'Astro Framework là gì? Hướng dẫn xây dựng website siêu nhanh',         date: '03/01/2026', cat: 'Dev',         icon: '🚀', color: '#e8fdf5', readTime: '12 phút' },
  { slug: 'google-analytics-4-huong-dan',     title: 'Google Analytics 4 — Hướng dẫn cài đặt và phân tích dữ liệu',         date: '25/12/2025', cat: 'Marketing',   icon: '📊', color: '#e8f4fd', readTime: '8 phút' },
];

const cats = ['Tất cả', 'SEO', 'Website', 'Design', 'Dev', 'Marketing'];
---

<BaseLayout title="Blog" description="Kiến thức website, SEO, design và marketing số từ đội ngũ chuyên gia MIKO TECH.">
  <main>

    <!-- Page Hero -->
    <div class="page-hero">
      <div class="container" style="position:relative;z-index:1;">
        <div class="label-tag" style="color:rgba(255,255,255,0.7);margin-bottom:12px;" data-hero-animate>TIN TỨC & KIẾN THỨC</div>
        <h1 data-hero-animate>KIẾN THỨC WEBSITE<br/>& MARKETING SỐ</h1>
        <p data-hero-animate>Cập nhật liên tục các thông tin, kiến thức và xu hướng mới nhất về website, SEO và digital marketing từ đội ngũ chuyên gia Miko Tech.</p>
      </div>
    </div>

    <section class="section" style="background:var(--bg-light);">
      <div class="container">

        <!-- Category Filter -->
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:40px;">
          {cats.map((cat, i) => (
            <button class="cat-btn" data-cat={cat}
              style={`padding:8px 20px;border-radius:50px;font-size:13px;font-weight:600;cursor:pointer;border:2px solid ${i===0?'var(--teal)':'#ddd'};background:${i===0?'var(--teal)':'white'};color:${i===0?'white':'var(--text-mid)'};transition:all 0.3s;`}>
              {cat}
            </button>
          ))}
        </div>

        <!-- Featured Post -->
        <div class="card" data-animate style="display:grid;grid-template-columns:1.2fr 1fr;overflow:hidden;margin-bottom:40px;">
          <div style="background:linear-gradient(135deg,var(--teal),var(--teal-darker));padding:48px;display:flex;flex-direction:column;justify-content:center;">
            <span class="service-tag" style="align-self:flex-start;margin-bottom:16px;">⭐ BÀI NỔI BẬT</span>
            <h2 style="font-size:clamp(18px,2.5vw,26px);font-weight:800;color:white;line-height:1.4;margin-bottom:16px;">
              {posts[0].title}
            </h2>
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;">
              <span style="font-size:13px;color:rgba(255,255,255,0.7);">📅 {posts[0].date}</span>
              <span style="font-size:13px;color:rgba(255,255,255,0.7);">⏱️ {posts[0].readTime}</span>
            </div>
            <a href={`/blog/${posts[0].slug}`} class="btn btn-white" style="align-self:flex-start;">Đọc ngay →</a>
          </div>
          <div style={`background:${posts[0].color};display:flex;align-items:center;justify-content:center;font-size:120px;`}>
            {posts[0].icon}
          </div>
        </div>

        <!-- Posts Grid -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;" id="postsGrid">
          {posts.slice(1).map((post, i) => (
            <a href={`/blog/${post.slug}`} class="blog-card card post-item" data-cat={post.cat}
              data-animate data-delay={String(i%3+1)} style="display:block;text-decoration:none;">
              <div style={`background:${post.color};height:180px;display:flex;align-items:center;justify-content:center;font-size:64px;position:relative;`}>
                {post.icon}
                <div style="position:absolute;top:12px;left:50%;transform:translateX(-50%);">
                  <span class="service-tag" style="font-size:10px;white-space:nowrap;">{post.cat}</span>
                </div>
              </div>
              <div class="blog-content">
                <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;">
                  <span class="blog-date">{post.date}</span>
                  <span style="font-size:11px;color:var(--teal);font-weight:600;">⏱️ {post.readTime}</span>
                </div>
                <h3 class="blog-title">{post.title}</h3>
                <div style="color:var(--teal);font-size:13px;font-weight:600;margin-top:12px;display:flex;align-items:center;gap:4px;">
                  Đọc thêm →
                </div>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <CTABanner />
  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns  = document.querySelectorAll('.cat-btn');
    const items = document.querySelectorAll('.post-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => { b.style.background='white'; b.style.color='var(--text-mid)'; b.style.borderColor='#ddd'; });
        btn.style.background='var(--teal)'; btn.style.color='white'; btn.style.borderColor='var(--teal)';

        const cat = btn.dataset.cat;
        items.forEach(item => {
          const show = cat === 'Tất cả' || item.dataset.cat === cat;
          item.style.display = show ? 'block' : 'none';
        });
      });
    });
  });
</script>

<style>
  @media (max-width: 1024px) {
    #postsGrid { grid-template-columns: repeat(2, 1fr) !important; }
    section .container > div[style*="grid-template-columns:1.2fr 1fr"] { grid-template-columns: 1fr !important; }
    section .container > div[style*="grid-template-columns:1.2fr 1fr"] > div:last-child { display: none; }
  }
  @media (max-width: 640px) {
    #postsGrid { grid-template-columns: 1fr !important; }
  }
</style>
