---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';

const posts = [
  { slug: 'table-of-contents-la-gi',     title: 'Table of Contents là gì? Hướng dẫn tạo mục lục cho website',      date: '27/02/2026', cat: 'SEO',       readTime: '5 phút',  img: 'https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?w=800&q=80&fit=crop' },
  { slug: 'elementor-la-gi',             title: 'Elementor là gì? Cách cài đặt và cấu hình cho người mới',         date: '20/02/2026', cat: 'Website',   readTime: '7 phút',  img: 'https://images.unsplash.com/photo-1547658719-da2b51169166?w=800&q=80&fit=crop' },
  { slug: 'google-knowledge-graph-la-gi', title: 'Google Knowledge Graph là gì? Hướng dẫn tối ưu chi tiết',        date: '16/02/2026', cat: 'SEO',       readTime: '8 phút',  img: 'https://images.unsplash.com/photo-1432888622747-4eb9a8f5a07d?w=800&q=80&fit=crop' },
  { slug: 'top-cong-ty-seo-viet-nam',    title: 'Top 10+ công ty SEO uy tín, chuyên nghiệp Việt Nam',              date: '06/02/2026', cat: 'SEO',       readTime: '10 phút', img: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80&fit=crop' },
  { slug: 'link-building-la-gi',         title: 'Link Building là gì? Chiến lược xây dựng backlink hiệu quả 2026',  date: '30/01/2026', cat: 'SEO',       readTime: '9 phút',  img: 'https://images.unsplash.com/photo-1526378722484-bd91ca387e72?w=800&q=80&fit=crop' },
  { slug: 'schema-markup-la-gi',         title: 'Schema Markup là gì? Hướng dẫn triển khai từ A đến Z',            date: '15/01/2026', cat: 'SEO',       readTime: '11 phút', img: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&q=80&fit=crop' },
  { slug: 'thiet-ke-ux-ui-la-gi',        title: 'UI/UX Design là gì? Nguyên tắc thiết kế trải nghiệm người dùng',  date: '10/01/2026', cat: 'Design',    readTime: '6 phút',  img: 'https://images.unsplash.com/photo-1561070791-2526d30994b5?w=800&q=80&fit=crop' },
  { slug: 'astro-framework-la-gi',       title: 'Astro Framework là gì? Hướng dẫn xây dựng website siêu nhanh',    date: '03/01/2026', cat: 'Dev',       readTime: '12 phút', img: 'https://images.unsplash.com/photo-1517180102446-f3ece451e9d8?w=800&q=80&fit=crop' },
  { slug: 'google-analytics-4-huong-dan', title: 'Google Analytics 4 — Hướng dẫn cài đặt và phân tích dữ liệu',    date: '25/12/2025', cat: 'Marketing', readTime: '8 phút',  img: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&q=80&fit=crop' },
];

const cats = ['Tất cả', 'SEO', 'Website', 'Design', 'Dev', 'Marketing'];
---

<BaseLayout title="Blog" description="Kiến thức website, SEO, design và marketing số từ đội ngũ chuyên gia GLOBAL TECH.">
  <main>

    <!-- Page Hero -->
    <div class="page-hero">
      <div class="container" style="position:relative;z-index:1;">
        <div class="label-tag" style="color:rgba(255,255,255,0.7);margin-bottom:12px;" data-hero-animate>TIN TỨC & KIẾN THỨC</div>
        <h1 data-hero-animate>KIẾN THỨC WEBSITE<br/>& MARKETING SỐ</h1>
        <p data-hero-animate>Cập nhật liên tục các thông tin, kiến thức và xu hướng mới nhất về website, SEO và digital marketing từ đội ngũ chuyên gia Global Tech.</p>
      </div>
    </div>

    <section class="section" style="background:var(--bg-light);">
      <div class="container">

        <!-- Category Filter -->
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:40px;">
          {cats.map((cat, i) => (
            <button class="cat-btn" data-cat={cat}
              style={`padding:8px 20px;border-radius:50px;font-size:13px;font-weight:600;cursor:pointer;border:2px solid ${i===0?'var(--teal)':'#ddd'};background:${i===0?'var(--teal)':'white'};color:${i===0?'white':'var(--text-mid)'};transition:all 0.3s;`}>
              {cat}
            </button>
          ))}
        </div>

        <!-- Featured Post -->
        <div class="card" data-animate style="display:grid;grid-template-columns:1.2fr 1fr;overflow:hidden;margin-bottom:40px;">
          <div style="background:linear-gradient(135deg,var(--teal),var(--teal-darker));padding:48px;display:flex;flex-direction:column;justify-content:center;">
            <span class="service-tag" style="align-self:flex-start;margin-bottom:16px;">⭐ BÀI NỔI BẬT</span>
            <h2 style="font-size:clamp(18px,2.5vw,26px);font-weight:800;color:white;line-height:1.4;margin-bottom:16px;">
              {posts[0].title}
            </h2>
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;">
              <span style="font-size:13px;color:rgba(255,255,255,0.7);">📅 {posts[0].date}</span>
              <span style="font-size:13px;color:rgba(255,255,255,0.7);">⏱️ {posts[0].readTime}</span>
            </div>
            <a href={`/blog/${posts[0].slug}`} class="btn btn-white" style="align-self:flex-start;">Đọc ngay →</a>
          </div>
          <div style="overflow:hidden;">
            <img src={posts[0].img} alt={posts[0].title} loading="eager" style="width:100%;height:100%;min-height:260px;object-fit:cover;display:block;" />
          </div>
        </div>

        <!-- Posts Grid -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;" id="postsGrid">
          {posts.slice(1).map((post, i) => (
            <a href={`/blog/${post.slug}`} class="blog-card card post-item" data-cat={post.cat}
              data-animate data-delay={String(i%3+1)} style="display:block;text-decoration:none;">
              <div class="blog-img-wrap" style="height:180px;position:relative;overflow:hidden;">
                <img src={post.img} alt={post.title} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" />
                <div style="position:absolute;top:12px;left:12px;">
                  <span class="service-tag" style="font-size:10px;white-space:nowrap;background:rgba(255,255,255,0.92);color:var(--teal);">{post.cat}</span>
                </div>
              </div>
              <div class="blog-content">
                <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;">
                  <span class="blog-date">{post.date}</span>
                  <span style="font-size:11px;color:var(--teal);font-weight:600;">⏱️ {post.readTime}</span>
                </div>
                <h3 class="blog-title">{post.title}</h3>
                <div style="color:var(--teal);font-size:13px;font-weight:600;margin-top:12px;display:flex;align-items:center;gap:4px;">
                  Đọc thêm →
                </div>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <CTABanner />
  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns  = document.querySelectorAll('.cat-btn');
    const items = document.querySelectorAll('.post-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => { b.style.background='white'; b.style.color='var(--text-mid)'; b.style.borderColor='#ddd'; });
        btn.style.background='var(--teal)'; btn.style.color='white'; btn.style.borderColor='var(--teal)';

        const cat = btn.dataset.cat;
        items.forEach(item => {
          const show = cat === 'Tất cả' || item.dataset.cat === cat;
          item.style.display = show ? 'block' : 'none';
        });
      });
    });
  });
</script>

<style>
  .blog-img-wrap img { transition: transform 0.5s ease; }
  .post-item:hover .blog-img-wrap img { transform: scale(1.07); }

  /* Blog card content */
  .post-item { display: flex; flex-direction: column; }
  .blog-content { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
  .blog-date { font-size: 12px; color: var(--text-light); font-weight: 600; }
  .blog-title {
    font-size: 15.5px;
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-item:hover .blog-title { color: var(--teal); }

  @media (max-width: 1024px) {
    #postsGrid { grid-template-columns: repeat(2, 1fr) !important; }
    section .container > div[style*="grid-template-columns:1.2fr 1fr"] { grid-template-columns: 1fr !important; }
    section .container > div[style*="grid-template-columns:1.2fr 1fr"] > div:last-child { display: none; }
  }
  @media (max-width: 640px) {
    #postsGrid { grid-template-columns: 1fr !important; }
  }
</style>
