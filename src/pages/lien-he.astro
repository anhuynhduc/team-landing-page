---
import BaseLayout from '../layouts/BaseLayout.astro';

// Lấy Web3Forms access key từ biến môi trường (xem .env.example).
// Đăng ký miễn phí tại https://web3forms.com bằng email ansuu552002@gmail.com để nhận key.
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<BaseLayout title="Liên Hệ – Global Tech">

  <!-- Hero -->
  <section class="contact-hero">
    <div class="container text-center">
      <span class="label ch-label">Liên Hệ Với Chúng Tôi</span>
      <h1 class="ch-title">Hãy Cùng<br><span class="text-teal">Bắt Đầu Ngay!</span></h1>
      <p class="ch-desc">
        Đội ngũ tư vấn của Global Tech luôn sẵn sàng hỗ trợ bạn 24/7. Hãy để lại thông tin và chúng tôi sẽ liên hệ trong vòng 15 phút!
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section contact-main">
    <div class="container contact-grid">

      <!-- Info -->
      <div class="contact-info">
        <div class="info-block anim-fade-up">
          <div class="info-icon">📞</div>
          <div>
            <h3 class="info-label">Hotline</h3>
            <a href="tel:0909326456" class="info-value">0909 326 456</a>
          </div>
        </div>

        <div class="info-block anim-fade-up">
          <div class="info-icon">📍</div>
          <div>
            <h3 class="info-label">Trụ Sở</h3>
            <p class="info-value">Tầng G, 485B Nguyễn Đình Chiểu, Phường Bàn Cờ,<br>Thành phố Hồ Chí Minh, Việt Nam</p>
          </div>
        </div>

        <div class="info-block anim-fade-up">
          <div class="info-icon">🕒</div>
          <div>
            <h3 class="info-label">Giờ Làm Việc</h3>
            <p class="info-value">Thứ 2 – Thứ 7: 8h00 – 18h00<br>Hỗ trợ kỹ thuật & tư vấn online 24/7</p>
          </div>
        </div>

        <div class="info-block anim-fade-up">
          <div class="info-icon">✉️</div>
          <div>
            <h3 class="info-label">Email</h3>
            <a href="mailto:hello@globaltech.vn" class="info-value">hello@globaltech.vn</a>
          </div>
        </div>

        <!-- Map -->
        <div class="contact-map anim-scale">
          <div class="map-placeholder">
            <div class="map-inner">
              <div class="map-pin">📍</div>
              <div class="map-circle"></div>
              <div class="map-circle map-circle--2"></div>
            </div>
            <p class="map-label">Global Tech – Thiết Kế Website Chuyên Nghiệp</p>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrap anim-fade-up">
        <div class="contact-form-card">
          <h2 class="cf-title">Gửi Yêu Cầu Báo Giá</h2>
          <p class="cf-desc">Điền thông tin bên dưới, chúng tôi sẽ phản hồi trong 15 phút!</p>

          <form class="cf-form" id="contactForm" novalidate>
            <!-- Web3Forms cấu hình -->
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
            <input type="hidden" name="subject" value="🔔 Yêu cầu báo giá mới từ website Global Tech" />
            <input type="hidden" name="from_name" value="Global Tech Website" />
            <!-- Honeypot chống spam -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="cf-row">
              <div class="cf-group">
                <label>Họ và tên <span class="req">*</span></label>
                <input type="text" id="cfName" name="Họ và tên" placeholder="Vui lòng nhập tên" required />
                <span class="cf-error" id="errName"></span>
              </div>
              <div class="cf-group">
                <label>Số điện thoại <span class="req">*</span></label>
                <input type="tel" id="cfPhone" name="Số điện thoại" placeholder="Vui lòng nhập số điện thoại" required />
                <span class="cf-error" id="errPhone"></span>
              </div>
            </div>
            <div class="cf-group">
              <label>Email</label>
              <input type="email" id="cfEmail" name="email" placeholder="Vui lòng nhập email" />
              <span class="cf-error" id="errEmail"></span>
            </div>
            <div class="cf-group">
              <label>Dịch vụ quan tâm</label>
              <select name="Dịch vụ quan tâm">
                <option value="">-- Chọn dịch vụ --</option>
                <option>Thiết kế Website</option>
                <option>Dịch vụ SEO</option>
                <option>Mobile App</option>
                <option>Digital Marketing</option>
                <option>Làm Đồ Án CNTT</option>
                <option>Khác</option>
              </select>
            </div>
            <div class="cf-group">
              <label>Mô tả nhu cầu</label>
              <textarea name="Mô tả nhu cầu" placeholder="Mô tả chi tiết dự án, yêu cầu, ngân sách..." rows="4"></textarea>
            </div>
            <button type="submit" class="btn-primary cf-submit">
              Gửi yêu cầu ngay
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </form>

          <div class="cf-success" id="cfSuccess" style="display:none">
            <div class="success-icon">✅</div>
            <h3>Gửi thành công!</h3>
            <p>Chúng tôi sẽ liên hệ với bạn trong vòng 15 phút. Cảm ơn bạn đã tin tưởng Global Tech!</p>
          </div>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
.contact-hero {
  padding: calc(var(--header-h) + 60px) 0 60px;
  background: linear-gradient(160deg, var(--bg) 60%, rgba(0,176,155,0.07));
}
.ch-label { display: block; margin-bottom: 20px; }
.ch-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.1;
}
.ch-desc {
  max-width: 560px;
  margin: 20px auto 0;
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.75;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 64px;
  align-items: start;
}

/* Info */
.contact-info { display: flex; flex-direction: column; gap: 28px; }
.info-block {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 20px;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s, box-shadow 0.3s;
}
.info-block:hover { transform: translateX(6px); box-shadow: var(--shadow-md); }
.info-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  width: 48px; height: 48px;
  background: var(--primary-glow);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.info-label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 700;
  color: var(--primary);
  font-family: var(--font-heading);
  margin-bottom: 4px;
}
.info-value {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}
a.info-value:hover { color: var(--primary); }

/* Map */
.contact-map {
  border-radius: var(--radius-md);
  overflow: hidden;
  aspect-ratio: 16/9;
  background: #E8F4F8;
}
.map-placeholder {
  height: 100%;
  background: linear-gradient(135deg, #D1E8E2, #B8DBD4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  position: relative;
}
.map-inner { position: relative; }
.map-pin { font-size: 3rem; animation: pinBounce 2s ease-in-out infinite; }
@keyframes pinBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
.map-circle {
  position: absolute;
  top: 50%; left: 50%;
  width: 80px; height: 80px;
  border: 2px solid rgba(0,176,155,0.4);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: ripple 2s ease-out infinite;
}
.map-circle--2 {
  width: 130px; height: 130px;
  border-color: rgba(0,176,155,0.2);
  animation-delay: 0.5s;
}
@keyframes ripple {
  0% { transform: translate(-50%,-50%) scale(0.8); opacity: 1; }
  100% { transform: translate(-50%,-50%) scale(1.2); opacity: 0; }
}
.map-label {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--primary-dark);
  text-align: center;
  padding: 0 20px;
}

/* Form */
.contact-form-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 40px;
  box-shadow: var(--shadow-md);
}
.cf-title {
  font-size: 1.6rem;
  font-weight: 900;
  margin-bottom: 8px;
}
.cf-desc { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 28px; }
.cf-form { display: flex; flex-direction: column; gap: 16px; }
.cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.cf-group { display: flex; flex-direction: column; gap: 6px; }
.cf-group label {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.8rem;
  color: var(--text);
  letter-spacing: 0.02em;
}
.cf-group input,
.cf-group select,
.cf-group textarea {
  padding: 12px 16px;
  background: var(--bg);
  border: 2px solid transparent;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--text);
  outline: none;
  transition: border-color 0.25s, box-shadow 0.25s;
  resize: none;
}
.cf-group input:focus,
.cf-group select:focus,
.cf-group textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(0,176,155,0.1);
  background: #fff;
}
.cf-submit { margin-top: 8px; justify-content: center; padding: 16px; font-size: 1rem; }

/* Validation */
.req { color: #e23b3b; font-weight: 700; }
.cf-error {
  display: none;
  font-size: 0.78rem;
  color: #e23b3b;
  margin-top: 2px;
  line-height: 1.3;
}
.cf-group.has-error .cf-error { display: block; }
.cf-group.has-error input {
  border-color: #e23b3b;
  box-shadow: 0 0 0 4px rgba(226, 59, 59, 0.1);
  background: #fff;
}

.cf-success {
  text-align: center;
  padding: 40px 20px;
}
.success-icon { font-size: 3rem; margin-bottom: 16px; }
.cf-success h3 { font-size: 1.4rem; font-weight: 800; color: var(--primary); }
.cf-success p { font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6; }

@media (max-width: 1024px) {
  .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  .contact-hero { padding: calc(var(--header-h) + 50px) 0 50px; }
  .ch-title { font-size: clamp(2rem, 4vw, 3.2rem); }
}

@media (max-width: 768px) {
  .contact-hero { padding: calc(var(--header-h) + 40px) 0 40px; }
  .ch-title { font-size: clamp(1.8rem, 5vw, 2.5rem); }
  .ch-desc { font-size: 1rem; margin-top: 16px; }
  .contact-info { gap: 20px; }
  .info-block { padding: 16px; gap: 12px; }
  .info-icon { width: 40px; height: 40px; font-size: 1.2rem; }
  .info-label { font-size: 0.65rem; }
  .info-value { font-size: 0.85rem; }
  .contact-form-card { padding: 28px 20px; }
  .cf-title { font-size: 1.3rem; }
  .cf-desc { font-size: 0.85rem; margin-bottom: 20px; }
  .cf-group input,
  .cf-group select,
  .cf-group textarea { padding: 10px 12px; font-size: 0.85rem; }
  .cf-submit { padding: 13px; font-size: 0.9rem; }
}

@media (max-width: 640px) {
  .ch-title { font-size: clamp(1.5rem, 4vw, 2rem); }
  .contact-info { gap: 16px; }
  .info-block { padding: 12px; }
  .contact-map { aspect-ratio: 16/10; }
  .contact-form-card { padding: 20px 16px; }
  .cf-title { font-size: 1.1rem; margin-bottom: 6px; }
  .cf-desc { font-size: 0.8rem; margin-bottom: 16px; }
  .cf-row { grid-template-columns: 1fr; }
  .cf-group input,
  .cf-group select,
  .cf-group textarea { padding: 9px 10px; font-size: 0.8rem; }
  .cf-submit { padding: 11px 16px; font-size: 0.8rem; margin-top: 6px; }
  .success-icon { font-size: 2.2rem; }
  .cf-success h3 { font-size: 1.2rem; }
  .cf-success p { font-size: 0.8rem; }
}
</style>

<script>
import { gsap } from 'gsap';

// Hero entrance
gsap.timeline({ delay: 0.4 })
  .from('.ch-title', { y: 40, opacity: 0, duration: 0.8, ease: 'power4.out' })
  .from('.ch-desc', { y: 20, opacity: 0, duration: 0.6 }, '-=0.4');

// Info blocks stagger
gsap.from('.info-block', {
  scrollTrigger: { trigger: '.contact-info', start: 'top 80%' },
  x: -30, opacity: 0,
  stagger: 0.1,
  duration: 0.6,
  ease: 'power3.out',
});

// Form entrance
gsap.from('.contact-form-card', {
  scrollTrigger: { trigger: '.contact-form-card', start: 'top 80%' },
  y: 40, opacity: 0,
  duration: 0.8,
  ease: 'power3.out',
});

// Form submit → gửi email qua Web3Forms
const form = document.getElementById('contactForm') as HTMLFormElement;
const success = document.getElementById('cfSuccess')!;

// ── Validation ──
const nameInput  = document.getElementById('cfName')  as HTMLInputElement;
const phoneInput = document.getElementById('cfPhone') as HTMLInputElement;
const emailInput = document.getElementById('cfEmail') as HTMLInputElement;

function setError(input: HTMLInputElement, errId: string, message: string) {
  const group = input.closest('.cf-group')!;
  const errEl = document.getElementById(errId)!;
  if (message) {
    group.classList.add('has-error');
    errEl.textContent = message;
  } else {
    group.classList.remove('has-error');
    errEl.textContent = '';
  }
}

function validateName(): boolean {
  const v = nameInput.value.trim();
  if (!v) { setError(nameInput, 'errName', 'Vui lòng nhập họ và tên.'); return false; }
  if (v.length < 2) { setError(nameInput, 'errName', 'Tên quá ngắn.'); return false; }
  setError(nameInput, 'errName', '');
  return true;
}

function validatePhone(): boolean {
  const v = phoneInput.value.trim();
  if (!v) { setError(phoneInput, 'errPhone', 'Vui lòng nhập số điện thoại.'); return false; }
  // SĐT Việt Nam: 10 số bắt đầu bằng 0, hoặc dạng +84/84 + 9 số
  const phoneRe = /^(0\d{9}|(\+?84)\d{9})$/;
  const normalized = v.replace(/[\s.-]/g, '');
  if (!phoneRe.test(normalized)) {
    setError(phoneInput, 'errPhone', 'Số điện thoại không hợp lệ (VD: 0909326456).');
    return false;
  }
  setError(phoneInput, 'errPhone', '');
  return true;
}

function validateEmail(): boolean {
  const v = emailInput.value.trim();
  if (!v) { setError(emailInput, 'errEmail', ''); return true; } // không bắt buộc
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRe.test(v)) {
    setError(emailInput, 'errEmail', 'Email không hợp lệ.');
    return false;
  }
  setError(emailInput, 'errEmail', '');
  return true;
}

// Validate realtime: kiểm tra khi rời ô; nếu đã có lỗi thì cập nhật ngay khi gõ
nameInput?.addEventListener('blur', validateName);
phoneInput?.addEventListener('blur', validatePhone);
emailInput?.addEventListener('blur', validateEmail);
nameInput?.addEventListener('input',  () => { if (nameInput.closest('.cf-group')!.classList.contains('has-error')) validateName(); });
phoneInput?.addEventListener('input', () => { if (phoneInput.closest('.cf-group')!.classList.contains('has-error')) validatePhone(); });
emailInput?.addEventListener('input', () => { if (emailInput.closest('.cf-group')!.classList.contains('has-error')) validateEmail(); });

form?.addEventListener('submit', async (e) => {
  e.preventDefault();

  // Chạy validate; nếu có lỗi thì dừng và focus ô lỗi đầu tiên
  const okName  = validateName();
  const okPhone = validatePhone();
  const okEmail = validateEmail();
  if (!okName || !okPhone || !okEmail) {
    const firstInvalid = !okName ? nameInput : !okPhone ? phoneInput : emailInput;
    firstInvalid.focus();
    return;
  }

  const btn = form.querySelector('.cf-submit') as HTMLButtonElement;
  const originalHTML = btn.innerHTML;
  btn.textContent = 'Đang gửi...';
  btn.disabled = true;

  try {
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: new FormData(form),
    });
    const data = await res.json();

    if (!res.ok || !data.success) {
      throw new Error(data.message || 'Gửi thất bại');
    }

    gsap.to(form, {
      opacity: 0, y: -20, duration: 0.4,
      onComplete: () => {
        form.style.display = 'none';
        success.style.display = 'block';
        gsap.from(success, { opacity: 0, scale: 0.9, duration: 0.5, ease: 'back.out(1.5)' });
      }
    });
  } catch (err) {
    console.error(err);
    alert('Rất tiếc, gửi yêu cầu không thành công. Vui lòng thử lại hoặc gọi hotline 0909 326 456.');
    btn.innerHTML = originalHTML;
    btn.disabled = false;
  }
});
</script>
