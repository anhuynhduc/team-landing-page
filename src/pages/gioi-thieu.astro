---
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
  {
    num: '01',
    title: 'Sáng Tạo',
    desc: 'Chúng tôi không bao giờ dừng lại ở những gì đã có. Mỗi dự án là một cơ hội để tạo ra điều chưa từng tồn tại.',
  },
  {
    num: '02',
    title: 'Kinh Nghiệm',
    desc: 'Đội ngũ developer và marketer giàu kinh nghiệm thực chiến trên đa nền tảng, sẵn sàng giải quyết mọi bài toán công nghệ của bạn.',
  },
  {
    num: '03',
    title: 'Thấu Hiểu',
    desc: 'Chúng tôi luôn đặt mình vào vị trí của khách hàng để thấu hiểu nhu cầu và mang đến giải pháp tốt nhất.',
  },
  {
    num: '04',
    title: 'Đa Dạng',
    desc: 'Từ website doanh nghiệp, app, chiến dịch marketing đến đồ án CNTT cho sinh viên — chúng tôi phục vụ đa dạng nhu cầu và quy mô.',
  },
];

const team = [
  { name: 'Nguyễn Minh Tuấn', role: 'CEO & Founder',      skill: 'Chiến lược sản phẩm',  img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80&fit=crop&crop=faces' },
  { name: 'Trần Thị Lan',     role: 'Creative Director',   skill: 'UI/UX & Thương hiệu',  img: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&q=80&fit=crop&crop=faces' },
  { name: 'Lê Văn Hùng',      role: 'Lead Developer',      skill: 'Web · App · Hệ thống', img: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&q=80&fit=crop&crop=faces' },
  { name: 'Phạm Thu Hà',      role: 'Marketing Lead',      skill: 'SEO · Ads · Content',  img: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&q=80&fit=crop&crop=faces' },
  { name: 'Đỗ Quang Huy',     role: 'Backend Engineer',    skill: 'API · Database · Cloud', img: 'https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=400&q=80&fit=crop&crop=faces' },
  { name: 'Vũ Khánh Linh',    role: 'Project Manager',     skill: 'Điều phối & QA',       img: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80&fit=crop&crop=faces' },
];
---

<BaseLayout title="Giới Thiệu – Global Tech">

  <!-- Hero About -->
  <section class="about-hero">
    <div class="container">
      <div class="about-hero-content">
        <span class="label about-label">Về Global Tech</span>
        <h1 class="about-h1">
          Chúng Tôi Là<br><span class="text-teal">Đội Ngũ</span><br>Công Nghệ Trẻ
        </h1>
        <p class="about-lead">
          Global Tech là đội ngũ chuyên thiết kế website, triển khai marketing số và nhận làm đồ án công nghệ thông tin theo yêu cầu. Chúng tôi kết hợp tư duy sản phẩm, kỹ thuật vững vàng và sự tận tâm để biến ý tưởng của bạn thành sản phẩm số thực sự hiệu quả.
        </p>
      </div>

      <!-- Hero image collage -->
      <div class="about-hero-visual">
        <div class="ahv-glow"></div>
        <div class="ahv-dots"></div>

        <div class="ahv-main">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=900&q=80&fit=crop" alt="Đội ngũ Global Tech làm việc cùng nhau" loading="eager" />
          <span class="ahv-main-tag"><span class="ahv-dot"></span>Global Tech Team</span>
        </div>

        <div class="ahv-sub">
          <img src="https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=600&q=80&fit=crop" alt="Phòng họp lên ý tưởng dự án" loading="lazy" />
        </div>

        <div class="ahv-badge ahv-badge--exp">
          <span class="ahvb-num" data-counter="12" data-suffix="+">12+</span>
          <span class="ahvb-label">Năm kinh nghiệm</span>
        </div>

        <div class="ahv-badge ahv-badge--proj">
          <div class="ahvb-icon">🚀</div>
          <div>
            <span class="ahvb-num-sm" data-counter="850" data-suffix="+">850+</span>
            <span class="ahvb-label">Dự án bàn giao</span>
          </div>
        </div>

        <div class="ahv-badge ahv-badge--rating">
          <div class="ahvb-stars">★★★★★</div>
          <span class="ahvb-label">4.9/5 từ khách hàng</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Chúng Tôi Là -->
  <section class="section" style="background:var(--white);text-align:center">
    <div class="container" style="max-width:780px">
      <span class="label anim-fade-up">Chúng Tôi Là</span>
      <h2 class="section-title anim-fade-up" style="margin-top:12px">
        Làm Việc Tận Tâm Đã Tạo Nên<br><span class="text-teal">Uy Tín Cho Global Tech</span>
      </h2>
      <p class="section-desc anim-fade-up" style="margin:20px auto 0">
        Chúng tôi không chỉ xây dựng website — chúng tôi kiến tạo hành trình số cho doanh nghiệp của bạn. Mỗi dự án là một cam kết về chất lượng, thẩm mỹ và hiệu quả kinh doanh thực tế.
      </p>
    </div>
  </section>

  <!-- Những dịch vụ nổi bật -->
  <section class="section about-services">
    <div class="container about-services-inner">
      <div class="about-services-text">
        <span class="label anim-fade-up">Những Dịch Vụ Nổi Bật</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">
          Làm Việc Tận Tâm<br>Đã Tạo Nên<br><span class="text-teal">Uy Tín Cho Chúng Tôi</span>
        </h2>
        <p class="section-desc anim-fade-up" style="margin-top:20px">
          Mỗi dịch vụ được triển khai bởi đội ngũ chuyên gia với quy trình bài bản, minh bạch và luôn đặt lợi ích của khách hàng lên hàng đầu.
        </p>
        <a href="/dich-vu" class="btn-primary anim-fade-up" style="margin-top:32px">Xem dịch vụ</a>
      </div>
      <div class="about-services-img anim-scale">
        <div class="office-visual">
          <div class="office-card">
            <img class="office-photo" src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=800&q=80&fit=crop" alt="Đội ngũ Global Tech trao đổi dự án" loading="lazy" />
            <div class="office-info">
              <h4 class="oi-title">Tận tâm trong từng chi tiết</h4>
              <p class="oi-sub">Quy trình minh bạch — báo giá rõ ràng — bàn giao đúng hẹn.</p>
            </div>
          </div>
          <div class="office-stat-bubble">
            <span class="osb-num" data-counter="98" data-suffix="%">0%</span>
            <span class="osb-label">Khách hàng hài lòng</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section team-section" style="background:var(--white)">
    <div class="container">
      <div class="text-center">
        <span class="label anim-fade-up">Đội Ngũ</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">
          Những Con Người<br><span class="text-teal">Global Tech</span>
        </h2>
        <p class="section-desc anim-fade-up" style="margin:20px auto 0">
          Mỗi thành viên là một mảnh ghép chuyên môn — cùng nhau biến mỗi dự án thành sản phẩm hoàn chỉnh và đáng tự hào.
        </p>
      </div>

      <div class="team-grid">
        {team.map((member) => (
          <div class="team-card">
            <div class="team-photo">
              <img src={member.img} alt={member.name} loading="lazy" />
              <div class="team-photo-overlay">
                <div class="team-socials">
                  <a href="#" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
                  <a href="#" aria-label="LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.25 8h4.5v12h-4.5zM8 8h4.3v1.64h.06c.6-1.06 2.06-2.18 4.24-2.18 4.54 0 5.38 2.74 5.38 6.3V20h-4.5v-5.34c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.81V20H8z"/></svg></a>
                  <a href="#" aria-label="Email"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg></a>
                </div>
              </div>
            </div>
            <h3 class="team-name">{member.name}</h3>
            <p class="team-role">{member.role}</p>
            <span class="team-skill">{member.skill}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Giá Trị Khác Biệt -->
  <section class="section values-section">
    <div class="container values-inner">
      <div class="values-text">
        <span class="label anim-fade-up">Giá Trị Cốt Lõi</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">
          Giá Trị Khác Biệt<br><span class="text-teal">Tại Global Tech</span>
        </h2>
        <p class="section-desc anim-fade-up" style="margin-top:20px">
          Bốn giá trị cốt lõi định hình cách chúng tôi làm việc mỗi ngày — đảm bảo mỗi sản phẩm bàn giao đều chỉn chu, đúng hẹn và mang lại giá trị thực cho khách hàng.
        </p>
      </div>

      <div class="values-cards" id="valuesCards">
        {values.map((v, i) => (
          <div
            class={`value-card ${i === 0 ? 'value-card--active' : ''}`}
            data-index={i}
          >
            <div class="vc-num">{v.num}</div>
            <div class="vc-body">
              <h3 class="vc-title">{v.title}</h3>
              <p class="vc-desc">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── HERO ─── */
.about-hero {
  padding: calc(var(--header-h) + 60px) 0 60px;
  background: linear-gradient(160deg, var(--bg) 60%, rgba(0,176,155,0.08));
}
.about-hero-content { text-align: center; max-width: 700px; margin: 0 auto 60px; }
.about-label { margin-bottom: 20px; display: block; }
.about-h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.1;
}
.about-lead {
  margin-top: 24px;
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.75;
}

/* Hero image collage */
.about-hero-visual {
  position: relative;
  max-width: 880px;
  margin: 0 auto;
  aspect-ratio: 16/10;
}
.ahv-glow {
  position: absolute;
  top: 8%; left: 10%;
  width: 70%; height: 80%;
  background: radial-gradient(ellipse, rgba(0,176,155,0.22), transparent 70%);
  filter: blur(10px);
  pointer-events: none;
  animation: ahvGlow 4s ease-in-out infinite;
}
@keyframes ahvGlow { 0%,100%{opacity:.55} 50%{opacity:1} }
.ahv-dots {
  position: absolute;
  bottom: 4%; right: 2%;
  width: 120px; height: 120px;
  background-image: radial-gradient(circle, var(--primary) 1.6px, transparent 1.6px);
  background-size: 16px 16px;
  opacity: 0.35;
  pointer-events: none;
}
.ahv-main {
  position: absolute;
  top: 0; left: 4%;
  width: 70%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.ahv-main img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
.ahv-main-tag {
  position: absolute;
  top: 14px; left: 14px;
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(6px);
  padding: 7px 14px;
  border-radius: var(--radius-pill);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.78rem;
  color: var(--text);
}
.ahv-dot { width: 8px; height: 8px; border-radius: 50%; background: #2BCB5E; box-shadow: 0 0 0 3px rgba(43,203,94,0.25); }
.ahv-sub {
  position: absolute;
  bottom: 2%; right: 2%;
  width: 42%;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 5px solid var(--white);
  box-shadow: var(--shadow-md);
}
.ahv-sub img { width: 100%; aspect-ratio: 5/4; object-fit: cover; }
.ahv-badge {
  position: absolute;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: 0 12px 40px rgba(0,0,0,0.15);
  padding: 14px 18px;
}
.ahv-badge--exp {
  top: 14%; right: 0;
  text-align: center;
  animation: ahvFloat 4.5s ease-in-out infinite;
}
.ahvb-num { display: block; font-family: var(--font-heading); font-weight: 900; font-size: 1.9rem; color: var(--primary); line-height: 1; }
.ahvb-num-sm { display: block; font-family: var(--font-heading); font-weight: 900; font-size: 1.2rem; color: var(--primary); line-height: 1; }
.ahvb-label { display: block; font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; font-family: var(--font-heading); font-weight: 600; }
.ahv-badge--proj {
  bottom: 16%; left: 0;
  display: flex; align-items: center; gap: 12px;
  animation: ahvFloat 5.2s ease-in-out infinite 0.6s;
}
.ahvb-icon {
  width: 40px; height: 40px; flex-shrink: 0;
  background: var(--primary-glow);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.2rem;
}
.ahv-badge--rating {
  top: -3%; left: 24%;
  text-align: center;
  animation: ahvFloat 4s ease-in-out infinite 1.2s;
}
.ahvb-stars { color: #F59E0B; font-size: 0.9rem; letter-spacing: 1px; }
@keyframes ahvFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }

/* Services split */
.about-services { background: var(--bg); }
.about-services-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.office-visual {
  position: relative;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 32px;
  box-shadow: var(--shadow-md);
}
.office-card {
  background: var(--bg);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.office-photo {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
}
.office-info { padding: 18px 16px; display: flex; flex-direction: column; gap: 6px; }
.oi-title { font-size: 1rem; font-weight: 800; color: var(--text); }
.oi-sub { font-size: 0.82rem; color: var(--text-muted); line-height: 1.55; }
.office-stat-bubble {
  position: absolute;
  top: 20px; right: -20px;
  background: var(--primary);
  color: #fff;
  padding: 16px 20px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-teal);
  text-align: center;
}
.osb-num {
  display: block;
  font-family: var(--font-heading);
  font-weight: 900;
  font-size: 2rem;
}
.osb-label {
  display: block;
  font-size: 0.72rem;
  font-family: var(--font-heading);
  opacity: 0.9;
  margin-top: 4px;
}

/* Team */
.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  margin-top: 56px;
}
.team-card {
  text-align: center;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 24px 24px 30px;
  transition: transform 0.35s, box-shadow 0.35s, border-color 0.35s;
}
.team-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: var(--primary-light); }
.team-photo {
  position: relative;
  width: 130px; height: 130px;
  margin: 0 auto 20px;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}
.team-photo img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s var(--transition);
}
.team-card:hover .team-photo img { transform: scale(1.08); }
.team-photo-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,176,155,0.85), transparent 65%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 14px;
  opacity: 0;
  transition: opacity 0.35s;
}
.team-card:hover .team-photo-overlay { opacity: 1; }
.team-socials { display: flex; gap: 8px; transform: translateY(10px); transition: transform 0.35s; }
.team-card:hover .team-socials { transform: translateY(0); }
.team-socials a {
  width: 30px; height: 30px;
  border-radius: 50%;
  background: rgba(255,255,255,0.95);
  color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s, color 0.2s, transform 0.2s;
}
.team-socials a:hover { background: var(--text); color: #fff; transform: translateY(-3px); }
.team-name { font-size: 1.1rem; font-weight: 800; }
.team-role { font-size: 0.85rem; color: var(--primary); font-family: var(--font-heading); font-weight: 700; margin-top: 4px; }
.team-skill {
  display: inline-block;
  margin-top: 12px;
  padding: 5px 14px;
  background: var(--bg);
  border-radius: var(--radius-pill);
  font-size: 0.72rem;
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--text-muted);
}

/* Values */
.values-section { background: var(--bg); }
.values-inner {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 80px;
  align-items: start;
}
.values-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.value-card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 28px;
  cursor: pointer;
  transition: background 0.35s, transform 0.35s, box-shadow 0.35s;
  border: 2px solid transparent;
}
.value-card:hover { transform: translateY(-4px); border-color: var(--primary-light); }
.value-card--active {
  background: var(--primary);
  color: #fff;
  box-shadow: var(--shadow-teal);
}
.vc-num {
  font-family: var(--font-heading);
  font-weight: 900;
  font-size: 2rem;
  opacity: 0.3;
  line-height: 1;
}
.value-card--active .vc-num { opacity: 0.5; color: #fff; }
.vc-title {
  font-size: 1.05rem;
  font-weight: 800;
  margin-top: 12px;
  color: var(--text);
}
.value-card--active .vc-title { color: #fff; }
.vc-desc {
  font-size: 0.83rem;
  line-height: 1.65;
  color: var(--text-muted);
  margin-top: 8px;
}
.value-card--active .vc-desc { color: rgba(255,255,255,0.85); }

@media (max-width: 1024px) {
  .about-services-inner { grid-template-columns: 1fr; }
  .team-grid { grid-template-columns: repeat(2, 1fr); }
  .values-inner { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .about-hero-visual { max-width: 480px; aspect-ratio: 4/3; }
  .ahv-badge { padding: 10px 14px; }
  .ahvb-num { font-size: 1.5rem; }
  .ahv-badge--exp { top: 8%; }
  .ahv-badge--rating { display: none; }
}
@media (max-width: 640px) {
  .team-grid { grid-template-columns: 1fr; max-width: 320px; margin-left: auto; margin-right: auto; }
  .team-grid { margin-top: 40px; }
  .values-cards { grid-template-columns: 1fr; }
  .about-hero-visual { max-width: 360px; }
  .ahv-badge--proj { padding: 8px 12px; }
  .ahvb-icon { width: 32px; height: 32px; font-size: 1rem; }
}
</style>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

// Hero entrance
const tl = gsap.timeline({ delay: 0.4 });
tl.from('.about-h1', { y: 50, opacity: 0, duration: 0.8, ease: 'power4.out' });
tl.from('.about-lead', { y: 20, opacity: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4');
tl.from('.ahv-main', { y: 50, opacity: 0, scale: 0.95, duration: 0.9, ease: 'power3.out' }, '-=0.3');
tl.from('.ahv-sub', { x: 40, opacity: 0, duration: 0.7, ease: 'power3.out' }, '-=0.5');
tl.from('.ahv-badge', { scale: 0, opacity: 0, stagger: 0.12, duration: 0.6, ease: 'back.out(2)' }, '-=0.4');

// Value cards interaction
const valueCards = document.querySelectorAll<HTMLElement>('.value-card');
valueCards.forEach(card => {
  card.addEventListener('click', () => {
    valueCards.forEach(c => c.classList.remove('value-card--active'));
    card.classList.add('value-card--active');

    // Animate the newly active card
    gsap.fromTo(card,
      { scale: 0.97 },
      { scale: 1, duration: 0.4, ease: 'back.out(2)' }
    );
  });
});

// Team cards stagger
gsap.from('.team-card', {
  scrollTrigger: { trigger: '.team-grid', start: 'top 80%' },
  y: 40, opacity: 0,
  stagger: 0.1,
  duration: 0.7,
  ease: 'power3.out',
});

// Values cards stagger
gsap.from('.value-card', {
  scrollTrigger: { trigger: '.values-cards', start: 'top 80%' },
  y: 30, opacity: 0,
  stagger: 0.1,
  duration: 0.6,
  ease: 'power2.out',
});
</script>

