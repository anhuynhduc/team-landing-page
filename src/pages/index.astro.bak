---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'VNG Cloud',
    cat: 'Điện toán đám mây',
    desc: 'Website thiết kế hình ảnh theo dạng 3D đặc sắc, tính năng đăng ký mua trực tuyến',
    color: '#1a1a2e',
    accent: '#00B09B',
    tag: 'Cloud & Hosting',
  },
  {
    title: 'Organic Food',
    cat: 'Thương mại điện tử',
    desc: 'Giao diện organic, hiển thị sản phẩm nổi bật, tích hợp giỏ hàng thông minh',
    color: '#2D6A4F',
    accent: '#95D5B2',
    tag: 'E-Commerce',
  },
  {
    title: 'Catapult Coin',
    cat: 'Tiền điện tử',
    desc: 'Website đơn giản, bố cục sắp xếp rõ ràng, dễ sử dụng cho nhà đầu tư',
    color: '#1C1C3A',
    accent: '#6C63FF',
    tag: 'Blockchain',
  },
  {
    title: 'MikoBeauty',
    cat: 'Làm đẹp & Spa',
    desc: 'Thiết kế sang trọng, nhẹ nhàng với tone màu pastel và hiệu ứng hiện đại',
    color: '#4A1942',
    accent: '#F9A8D4',
    tag: 'Beauty',
  },
];

const services = [
  {
    icon: '🌐',
    title: 'Thiết Kế Website',
    desc: 'Giao diện chuẩn UX/UI, responsive, tốc độ cao và thân thiện với công cụ tìm kiếm.',
    href: '/dich-vu/thiet-ke-website',
  },
  {
    icon: '🔍',
    title: 'Dịch Vụ SEO',
    desc: 'Tối ưu từ khóa, xây dựng backlink chất lượng, đưa website lên top Google bền vững.',
    href: '/dich-vu/seo',
  },
  {
    icon: '📱',
    title: 'Mobile App',
    desc: 'Phát triển ứng dụng iOS & Android với trải nghiệm người dùng vượt trội.',
    href: '/dich-vu/mobile-app',
  },
  {
    icon: '📈',
    title: 'Digital Marketing',
    desc: 'Chiến lược quảng cáo đa kênh: Facebook, Google, TikTok Ads đúng tệp khách hàng.',
    href: '/dich-vu',
  },
];

const stats = [
  { number: 200, prefix: '+', suffix: '', label: 'Website hoạt động hiệu quả' },
  { number: 8,   prefix: '+', suffix: ' năm', label: 'Kinh nghiệm thực chiến' },
  { number: 500, prefix: '+', suffix: '', label: 'Khách hàng hài lòng' },
  { number: 50,  prefix: '+', suffix: '', label: 'Chuyên gia công nghệ' },
];

const blogs = [
  {
    date: '27/02/2026',
    title: 'Table of Contents là gì? Hướng dẫn tạo mục lục cho website',
    excerpt: 'Hiện nay các bài viết có nội dung ngày càng dài, chuyên sâu và cạnh tranh hơn, người đọc không còn kiên nhẫn đọc từng đoạn...',
    color: '#E8F5F3',
    img: '📋',
  },
  {
    date: '20/02/2026',
    title: 'Elementor là gì? Cách cài đặt và cấu hình cho người mới',
    excerpt: 'Trong quá trình xây dựng website, việc chỉnh sửa giao diện bằng code can thiệp vào theme hay viết CSS, HTML thường gây khó khăn...',
    color: '#EEF2FF',
    img: '🎨',
  },
  {
    date: '16/02/2026',
    title: 'Google Knowledge Graph là gì? Hướng dẫn tối ưu chi tiết',
    excerpt: 'Google đã tạo ra Google Knowledge Graph, một bước tiến lớn giúp công cụ tìm kiếm trở nên thông minh, chính xác và nhanh hơn...',
    color: '#FFF7ED',
    img: '🔍',
  },
];
---

<BaseLayout title="TechViet – Thiết Kế Website & Dịch Vụ Marketing Chuyên Nghiệp">

  <!-- ═══════════════════════════════════
       SECTION 1: HERO
  ═══════════════════════════════════ -->
  <section class="hero">
    <div class="hero-bg-shape"></div>
    <div class="hero-bg-dots"></div>

    <div class="container hero-inner">
      <!-- Left: Text -->
      <div class="hero-text">
        <div class="hero-label">
          <span class="label">Giải Pháp Toàn Diện</span>
        </div>
        <h1 class="hero-title">
          <span class="hero-title-line clip-word"><span>Thiết Kế</span></span>
          <span class="hero-title-line clip-word"><span>Website &</span></span>
          <span class="hero-title-line clip-word hero-title-accent"><span>Dịch Vụ</span></span>
          <span class="hero-title-line clip-word hero-title-accent"><span>Marketing</span></span>
        </h1>
        <p class="hero-desc">
          Không chỉ thiết kế web chuẩn giao diện và trải nghiệm người dùng, chúng tôi cung cấp giải pháp Marketing toàn diện số — điểm tựa vững chắc giúp doanh nghiệp của bạn phát triển lâu dài và bền vững.
        </p>
        <div class="hero-actions">
          <a href="/dich-vu" class="btn-primary hero-cta">
            Tìm hiểu ngay
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/lien-he" class="btn-outline">Tư vấn miễn phí</a>
        </div>

        <!-- Trust badges -->
        <div class="hero-trust">
          <div class="trust-item">
            <span class="trust-icon">✅</span>
            <span>Cam kết chất lượng</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">⚡</span>
            <span>Bàn giao đúng hạn</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">🔒</span>
            <span>Bảo hành 12 tháng</span>
          </div>
        </div>
      </div>

      <!-- Right: Project Grid -->
      <div class="hero-grid">
        {projects.map((p, i) => (
          <a href="/du-an" class="project-card" style={`--card-color: ${p.color}; --card-accent: ${p.accent};`}>
            <div class="project-card-inner">
              <div class="project-mockup">
                <div class="mockup-bar">
                  <span></span><span></span><span></span>
                </div>
                <div class="mockup-body">
                  <div class="mockup-hero-strip" style={`background: linear-gradient(135deg, ${p.color}, ${p.accent})`}></div>
                  <div class="mockup-lines">
                    <div class="ml"></div><div class="ml ml--short"></div><div class="ml ml--med"></div>
                  </div>
                  <div class="mockup-grid">
                    <div class="mg" style={`background:${p.accent}22`}></div>
                    <div class="mg" style={`background:${p.color}22`}></div>
                  </div>
                </div>
              </div>
              <div class="project-info">
                <span class="project-tag" style={`background:${p.accent}22; color:${p.accent}`}>{p.tag}</span>
                <h3 class="project-title">{p.title}</h3>
                <p class="project-desc">{p.desc}</p>
              </div>
              <div class="project-hover-overlay">
                <span>Xem dự án →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="hero-scroll-hint">
      <div class="scroll-ball"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 2: STATS
  ═══════════════════════════════════ -->
  <section class="stats-section">
    <div class="stats-inner">
      {stats.map((s) => (
        <div class="stat-item">
          <div class="stat-number-wrap">
            <span
              class="stat-number"
              data-counter={s.number}
              data-prefix={s.prefix}
              data-suffix={s.suffix}
            >{s.prefix}0{s.suffix}</span>
          </div>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 3: SERVICES
  ═══════════════════════════════════ -->
  <section class="section services-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="label anim-fade-up">Những Gì Chúng Tôi Làm</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">
          Giải Pháp Dịch Vụ<br><span class="text-teal">Toàn Diện</span>
        </h2>
        <p class="section-desc anim-fade-up" style="margin:20px auto 0">
          Chúng tôi cung cấp đầy đủ các dịch vụ công nghệ và marketing giúp doanh nghiệp của bạn phát triển mạnh mẽ trên môi trường số.
        </p>
      </div>

      <div class="services-grid anim-stagger">
        {services.map((svc) => (
          <a href={svc.href} class="service-card">
            <div class="service-icon">{svc.icon}</div>
            <h3 class="service-title">{svc.title}</h3>
            <p class="service-desc">{svc.desc}</p>
            <span class="service-cta">
              Tìm hiểu thêm
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
            <div class="service-card-border"></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 4: ABOUT TEASER
  ═══════════════════════════════════ -->
  <section class="section about-teaser">
    <div class="container about-teaser-inner">
      <div class="about-teaser-text">
        <span class="label anim-fade-up">Về Chúng Tôi</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">
          Đội Ngũ Chiến Binh<br><span class="text-teal">Công Nghệ</span>
        </h2>
        <p class="section-desc anim-fade-up" style="margin-top:20px">
          Với nhiều năm kinh nghiệm thực chiến trên thị trường, chúng tôi đã đồng hành cùng hàng trăm doanh nghiệp xây dựng hình ảnh thương hiệu số mạnh mẽ và bền vững.
        </p>
        <div class="value-pills anim-fade-up">
          {['🎯 Sáng Tạo', '💡 Kinh Nghiệm', '🤝 Thấu Hiểu', '🌐 Đa Dạng'].map(v => (
            <span class="value-pill">{v}</span>
          ))}
        </div>
        <a href="/gioi-thieu" class="btn-primary anim-fade-up" style="margin-top:32px">
          Tìm hiểu về chúng tôi
        </a>
      </div>

      <div class="about-teaser-visual anim-scale">
        <div class="macbook-wrap">
          <div class="macbook">
            <div class="macbook-screen">
              <div class="screen-content">
                <div class="sc-header">
                  <div class="sc-dots"><span></span><span></span><span></span></div>
                  <div class="sc-bar"></div>
                </div>
                <div class="sc-hero" style="background: linear-gradient(135deg,#00B09B,#4ECDC4)">
                  <div class="sc-text">
                    <div class="sc-line sc-line--title"></div>
                    <div class="sc-line sc-line--sub"></div>
                    <div class="sc-btn-mock"></div>
                  </div>
                </div>
                <div class="sc-body">
                  <div class="sc-cards">
                    <div class="sc-card"></div>
                    <div class="sc-card"></div>
                    <div class="sc-card"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="macbook-notch"></div>
            <div class="macbook-base"></div>
            <div class="macbook-foot"></div>
          </div>
          <div class="macbook-glow"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 5: PORTFOLIO SHOWCASE
  ═══════════════════════════════════ -->
  <section class="section portfolio-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="label anim-fade-up">Dự Án Nổi Bật</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">
          Những Công Trình<br><span class="text-teal">Chúng Tôi Tự Hào</span>
        </h2>
      </div>

      <div class="portfolio-grid anim-stagger">
        {projects.map((p) => (
          <a href="/du-an" class="portfolio-item" style={`--pa:${p.accent}; --pc:${p.color}`}>
            <div class="portfolio-img" style={`background: linear-gradient(135deg,${p.color}EE,${p.accent}88)`}>
              <div class="portfolio-mockup-inner">
                <div style="height:8px;background:rgba(255,255,255,0.3);border-radius:4px;margin-bottom:10px"></div>
                <div style="height:6px;background:rgba(255,255,255,0.2);border-radius:4px;width:70%"></div>
                <div style="height:6px;background:rgba(255,255,255,0.15);border-radius:4px;width:50%;margin-top:6px"></div>
              </div>
              <div class="portfolio-overlay">
                <span>Xem chi tiết</span>
              </div>
            </div>
            <div class="portfolio-meta">
              <span class="portfolio-cat">{p.cat}</span>
              <h3 class="portfolio-title">{p.title}</h3>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center" style="margin-top:48px">
        <a href="/du-an" class="btn-outline anim-fade-up">Xem tất cả dự án</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 6: BLOG
  ═══════════════════════════════════ -->
  <section class="section blog-section" style="background:var(--white)">
    <div class="container">
      <div class="section-header" style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:16px">
        <div>
          <span class="label anim-fade-up">Kiến Thức Website</span>
          <h2 class="section-title anim-fade-up" style="margin-top:12px">
            Bài Viết Mới Nhất
          </h2>
          <p class="section-desc anim-fade-up" style="margin-top:12px">
            Cập nhật thông tin, kiến thức, xu hướng mới nhất về website cho bạn.
          </p>
        </div>
        <a href="/blog" class="btn-outline anim-fade-up">Xem tất cả →</a>
      </div>

      <div class="blog-grid anim-stagger">
        {blogs.map((b) => (
          <article class="blog-card card">
            <div class="blog-card-img" style={`background: ${b.color}`}>
              <div class="badge">⬡ TECHVIET</div>
              <div class="blog-emoji">{b.img}</div>
            </div>
            <div class="blog-card-body">
              <span class="blog-date">{b.date}</span>
              <h3 class="blog-title">{b.title}</h3>
              <p class="blog-excerpt">{b.excerpt}</p>
              <a href="/blog" class="blog-read-more">Đọc tiếp →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 7: CTA BANNER
  ═══════════════════════════════════ -->
  <section class="cta-banner">
    <div class="cta-bg-anim">
      <div class="cta-blob cta-blob--1"></div>
      <div class="cta-blob cta-blob--2"></div>
    </div>
    <div class="container cta-inner">
      <div class="cta-text">
        <h2 class="cta-title">
          Ngay bây giờ chính là thời điểm sớm nhất
        </h2>
        <p class="cta-desc">
          Bước gần hơn đến thành công của bạn bằng cách trò chuyện với chúng tôi
        </p>
      </div>
      <a href="/lien-he" class="btn-white cta-btn">
        Liên hệ ngay
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── HERO ─── */
.hero {
  min-height: 100vh;
  padding: calc(var(--header-h) + 48px) 0 80px;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.hero-bg-shape {
  position: absolute;
  top: -20%;
  right: -10%;
  width: 60%;
  height: 130%;
  background: linear-gradient(135deg, #00B09B18, #4ECDC420, transparent 70%);
  border-radius: 40% 60% 60% 40% / 40% 50% 50% 60%;
  pointer-events: none;
}
.hero-bg-dots {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, #00B09B18 1.5px, transparent 1.5px);
  background-size: 36px 36px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse at 80% 50%, black 30%, transparent 70%);
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
@media (max-width: 1024px) {
  .hero-inner { gap: 48px; }
}
@media (max-width: 768px) {
  .hero-inner { gap: 32px; }
}

/* Hero Text */
.hero-label { margin-bottom: 20px; }
.hero-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  line-height: 1.05;
  text-transform: uppercase;
  letter-spacing: 0.01em;
}
.hero-title-line {
  display: block;
  overflow: hidden;
}
.hero-title-line > span { display: block; }
.hero-title-accent > span { color: var(--primary); }

.hero-desc {
  margin-top: 24px;
  font-size: 1rem;
  color: var(--text-muted);
  line-height: 1.75;
  max-width: 460px;
}
.hero-actions {
  display: flex;
  gap: 16px;
  margin-top: 36px;
  flex-wrap: wrap;
}
.hero-cta { font-size: 1rem; padding: 16px 36px; }

.hero-trust {
  display: flex;
  gap: 24px;
  margin-top: 32px;
  flex-wrap: wrap;
}
@media (max-width: 768px) {
  .hero-trust { gap: 16px; margin-top: 24px; }
}
.trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--text-muted);
}
.trust-icon { font-size: 1rem; }

/* Project Grid */
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.project-card {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--white);
  box-shadow: var(--shadow-sm);
  transition: transform 0.4s var(--transition), box-shadow 0.4s var(--transition);
  position: relative;
  display: block;
}
.project-card:hover { transform: translateY(-10px) scale(1.02); box-shadow: 0 20px 50px rgba(0,0,0,0.12); }
.project-card-inner { height: 100%; display: flex; flex-direction: column; }

/* Website Mockup inside card */
.project-mockup {
  background: #F0F0F0;
  border-radius: 8px 8px 0 0;
}
.mockup-bar {
  display: flex; gap: 5px; padding: 8px 10px; background: #E8E8E8;
  border-radius: 8px 8px 0 0;
}
.mockup-bar span {
  width: 8px; height: 8px; border-radius: 50%;
  background: #ccc;
}
.mockup-bar span:nth-child(1) { background: #FF5F57; }
.mockup-bar span:nth-child(2) { background: #FFBD2E; }
.mockup-bar span:nth-child(3) { background: #28C840; }
.mockup-body { padding: 6px; }
.mockup-hero-strip {
  height: 56px;
  border-radius: 4px;
  margin-bottom: 6px;
}
.mockup-lines { display: flex; flex-direction: column; gap: 4px; padding: 4px; }
.ml { height: 5px; background: #E0E0E0; border-radius: 3px; }
.ml--short { width: 60%; }
.ml--med { width: 80%; }
.mockup-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; padding-top: 0; }
.mg { height: 32px; border-radius: 4px; }

.project-info { padding: 14px; flex: 1; }
.project-tag {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-pill);
  margin-bottom: 8px;
  font-family: var(--font-heading);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.project-title {
  font-size: 0.95rem;
  font-weight: 800;
  margin-bottom: 4px;
}
.project-desc {
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.5;
}

.project-hover-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(0,176,155,0.92), rgba(78,205,196,0.92));
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.35s;
  border-radius: var(--radius-md);
}
.project-hover-overlay span {
  color: #fff;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1rem;
}
.project-card:hover .project-hover-overlay { opacity: 1; }

/* Scroll hint */
.hero-scroll-hint {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  width: 28px; height: 46px;
  border: 2px solid rgba(0,176,155,0.3);
  border-radius: 14px;
  display: flex;
  justify-content: center;
  padding-top: 6px;
}
.scroll-ball {
  width: 6px; height: 6px;
  background: var(--primary);
  border-radius: 50%;
  animation: scrollBall 2s ease-in-out infinite;
}
@keyframes scrollBall {
  0% { transform: translateY(0); opacity: 1; }
  80% { transform: translateY(18px); opacity: 0; }
  100% { transform: translateY(0); opacity: 0; }
}

/* ─── STATS ─── */
.stats-section {
  background: linear-gradient(135deg, var(--primary), var(--primary-light) 60%, #96C93D);
  padding: 0;
}
.stats-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 56px 24px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.stat-item {
  text-align: center;
  padding: 20px;
  border-right: 1px solid rgba(255,255,255,0.2);
}
.stat-item:last-child { border-right: none; }
@media (max-width: 1024px) {
  .stats-inner { padding: 48px 24px; grid-template-columns: repeat(2, 1fr); }
  .stat-item { padding: 24px 16px; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.2); }
  .stat-item:nth-child(3), .stat-item:nth-child(4) { border-bottom: none; }
}
@media (max-width: 640px) {
  .stats-inner { padding: 40px 16px; grid-template-columns: 1fr; }
  .stat-item { padding: 20px 12px; border-bottom: 1px solid rgba(255,255,255,0.2); }
  .stat-item:last-child { border-bottom: none; }
}
.stat-number {
  display: block;
  font-family: var(--font-heading);
  font-weight: 900;
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  color: #fff;
  line-height: 1;
}
.stat-label {
  margin-top: 10px;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.8);
  font-family: var(--font-heading);
  font-weight: 500;
}

/* ─── SERVICES ─── */
.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-top: 56px;
}
@media (max-width: 1024px) {
  .services-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 48px; }
}
@media (max-width: 640px) {
  .services-grid { grid-template-columns: 1fr; gap: 16px; margin-top: 40px; }
}
.service-card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 36px 28px;
  position: relative;
  overflow: hidden;
  transition: transform 0.35s var(--transition), box-shadow 0.35s var(--transition);
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--shadow-sm);
}
.service-card:hover { transform: translateY(-10px); box-shadow: var(--shadow-lg); }
.service-card:hover .service-card-border { bottom: 0; }
@media (max-width: 768px) {
  .service-card { padding: 28px 20px; gap: 10px; }
}
@media (max-width: 640px) {
  .service-card { padding: 24px 16px; }
}
.service-card-border {
  position: absolute;
  left: 0; right: 0; bottom: -4px;
  height: 4px;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  transition: bottom 0.35s;
}
.service-icon { font-size: 2.5rem; }
.service-title {
  font-size: 1.05rem;
  font-weight: 800;
  line-height: 1.2;
}
.service-desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.65;
  flex: 1;
}
.service-cta {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--primary);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.85rem;
  margin-top: 8px;
  transition: gap 0.2s;
}
.service-card:hover .service-cta { gap: 10px; }

/* ─── ABOUT TEASER ─── */
.about-teaser { background: var(--bg); }
.about-teaser-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
@media (max-width: 1024px) {
  .about-teaser-inner { gap: 60px; }
}
@media (max-width: 768px) {
  .about-teaser-inner { gap: 40px; }
}
.value-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}
@media (max-width: 768px) {
  .value-pills { gap: 8px; margin-top: 20px; }
}
.value-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 18px;
  background: var(--white);
  border: 2px solid var(--border);
  border-radius: var(--radius-pill);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.82rem;
  color: var(--text);
  transition: background 0.3s, border-color 0.3s, color 0.3s;
}
.value-pill:hover { background: var(--primary); border-color: var(--primary); color: #fff; }
@media (max-width: 768px) {
  .value-pill { padding: 6px 14px; font-size: 0.75rem; }
}

/* MacBook Mockup */
.about-teaser-visual { position: relative; }
.macbook-wrap { position: relative; }
.macbook {
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  position: relative;
}
.macbook-screen {
  background: #1A1A2E;
  border-radius: 12px 12px 0 0;
  padding: 12px;
  border: 8px solid #2D2D44;
  box-shadow: 0 0 0 2px #3D3D5C, 0 20px 60px rgba(0,0,0,0.3);
  aspect-ratio: 16/10;
  overflow: hidden;
  animation: macScreenGlow 4s ease-in-out infinite;
}
@keyframes macScreenGlow {
  0%, 100% { box-shadow: 0 0 0 2px #3D3D5C, 0 20px 60px rgba(0,0,0,0.3), 0 0 30px rgba(0,176,155,0.1); }
  50%       { box-shadow: 0 0 0 2px #3D3D5C, 0 20px 60px rgba(0,0,0,0.3), 0 0 50px rgba(0,176,155,0.25); }
}

/* Screen content */
.screen-content { height: 100%; display: flex; flex-direction: column; }
.sc-header { background: #2D2D44; padding: 6px 10px; display: flex; align-items: center; gap: 8px; }
.sc-dots { display: flex; gap: 4px; }
.sc-dots span { width: 6px; height: 6px; border-radius: 50%; background: #555; }
.sc-dots span:nth-child(1) { background: #FF5F57; }
.sc-dots span:nth-child(2) { background: #FFBD2E; }
.sc-dots span:nth-child(3) { background: #28C840; }
.sc-bar { flex: 1; height: 14px; background: rgba(255,255,255,0.05); border-radius: 7px; }

.sc-hero {
  height: 35%;
  display: flex;
  align-items: center;
  padding: 16px;
}
.sc-text { display: flex; flex-direction: column; gap: 6px; }
.sc-line { height: 6px; border-radius: 3px; background: rgba(255,255,255,0.7); }
.sc-line--title { width: 160px; height: 8px; }
.sc-line--sub { width: 100px; }
.sc-btn-mock { width: 70px; height: 20px; background: rgba(255,255,255,0.9); border-radius: 10px; margin-top: 6px; }

.sc-body { flex: 1; background: #0D1117; padding: 12px; }
.sc-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 6px; }
.sc-card { height: 40px; background: rgba(255,255,255,0.04); border-radius: 4px; border: 1px solid rgba(255,255,255,0.06); }

.macbook-notch { height: 4px; background: #2D2D44; }
.macbook-base {
  height: 20px;
  background: linear-gradient(180deg, #C8C8C8, #A8A8A8);
  border-radius: 0 0 4px 4px;
}
.macbook-foot {
  width: 60%;
  height: 8px;
  background: #A0A0A0;
  margin: 0 auto;
  border-radius: 0 0 8px 8px;
}
.macbook-glow {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 40%;
  background: radial-gradient(ellipse, rgba(0,176,155,0.2), transparent 70%);
  pointer-events: none;
  animation: macGlow 4s ease-in-out infinite;
}
@keyframes macGlow {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ─── PORTFOLIO ─── */
.portfolio-section { background: var(--bg); }
.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 56px;
}
@media (max-width: 1024px) {
  .portfolio-grid { grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 48px; }
}
@media (max-width: 640px) {
  .portfolio-grid { grid-template-columns: 1fr; gap: 16px; margin-top: 40px; }
}
.portfolio-item { border-radius: var(--radius-md); overflow: hidden; }
.portfolio-img {
  aspect-ratio: 4/3;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  overflow: hidden;
  transition: transform 0.4s;
}
.portfolio-item:hover .portfolio-img { transform: scale(1.03); }
.portfolio-mockup-inner { width: 100%; }
.portfolio-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.35s;
}
.portfolio-overlay span {
  color: #fff;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.95rem;
}
.portfolio-item:hover .portfolio-overlay { opacity: 1; }
.portfolio-meta {
  background: var(--white);
  padding: 16px;
  border-radius: 0 0 var(--radius-md) var(--radius-md);
}
.portfolio-cat {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--primary);
  font-family: var(--font-heading);
}
.portfolio-title {
  font-size: 1rem;
  font-weight: 800;
  margin-top: 4px;
}

/* ─── BLOG ─── */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  margin-top: 48px;
}
@media (max-width: 1024px) {
  .blog-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 48px; }
}
@media (max-width: 640px) {
  .blog-grid { grid-template-columns: 1fr; gap: 20px; margin-top: 40px; }
}
.blog-card { display: flex; flex-direction: column; }
.blog-card-img {
  height: 180px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16px;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.blog-emoji { font-size: 3.5rem; margin: auto; }
@media (max-width: 768px) {
  .blog-card-img { height: 160px; padding: 12px; }
  .blog-emoji { font-size: 2.8rem; }
}
.blog-card-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
@media (max-width: 768px) {
  .blog-card-body { padding: 16px; }
}
.blog-date { font-size: 0.78rem; color: var(--text-light); font-family: var(--font-heading); font-weight: 600; }
.blog-title {
  font-size: 1rem;
  font-weight: 800;
  margin-top: 8px;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.blog-excerpt {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.65;
  margin-top: 10px;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.blog-read-more {
  color: var(--primary);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.85rem;
  margin-top: 16px;
  transition: gap 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.blog-read-more:hover { gap: 8px; }

/* ─── CTA BANNER ─── */
.cta-banner {
  background: linear-gradient(135deg, var(--primary), #4ECDC4 60%, #96C93D);
  padding: 72px 0;
  position: relative;
  overflow: hidden;
}
.cta-bg-anim { position: absolute; inset: 0; pointer-events: none; }
.cta-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.3;
}
.cta-blob--1 { width: 400px; height: 400px; background: #fff; top: -150px; left: -100px; animation: blobFloat 6s ease-in-out infinite; }
.cta-blob--2 { width: 300px; height: 300px; background: #96C93D; bottom: -100px; right: -80px; animation: blobFloat 8s ease-in-out infinite reverse; }
@keyframes blobFloat {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20px, -20px); }
}
.cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  flex-wrap: wrap;
  position: relative;
}
.cta-title {
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  color: #fff;
  font-weight: 900;
  line-height: 1.2;
}
.cta-desc {
  font-size: 1rem;
  color: rgba(255,255,255,0.85);
  margin-top: 12px;
}
.cta-btn { font-size: 1.05rem; padding: 16px 40px; flex-shrink: 0; }
@media (max-width: 768px) {
  .cta-inner { gap: 24px; text-align: center; justify-content: center; }
  .cta-desc { font-size: 0.95rem; }
  .cta-btn { font-size: 0.95rem; padding: 14px 32px; }
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .hero-inner { grid-template-columns: 1fr; gap: 48px; }
  .hero-grid { max-width: 560px; }
  .about-teaser-inner { grid-template-columns: 1fr; }
  .about-teaser-visual { display: none; }
}
@media (max-width: 768px) {
  .hero-inner { gap: 32px; }
  .section-header { justify-content: center; }
}
@media (max-width: 640px) {
  .hero-inner { gap: 24px; }
  .hero-grid { grid-template-columns: 1fr; }
  .hero-title { font-size: clamp(1.8rem, 5vw, 2.5rem); }
  .hero-desc { font-size: 0.95rem; margin-top: 16px; }
  .hero-actions { gap: 12px; margin-top: 24px; }
  .hero-cta { font-size: 0.9rem; padding: 13px 28px; }
  .cta-inner { flex-direction: column; text-align: center; justify-content: center; }
}
</style>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

// ─── Hero Entrance ───
const heroTl = gsap.timeline({ delay: 0.5 });

// Label
heroTl.from('.hero-label', {
  y: 20, opacity: 0, duration: 0.6, ease: 'power3.out'
});

// Title lines reveal
heroTl.from('.hero-title-line > span', {
  y: '110%',
  stagger: 0.1,
  duration: 0.8,
  ease: 'power4.out',
}, '-=0.3');

// Description
heroTl.from('.hero-desc', {
  y: 20, opacity: 0, duration: 0.6, ease: 'power2.out'
}, '-=0.4');

// Actions
heroTl.from('.hero-actions > *', {
  y: 20, opacity: 0, stagger: 0.1, duration: 0.5, ease: 'power2.out'
}, '-=0.3');

// Trust items
heroTl.from('.trust-item', {
  y: 15, opacity: 0, stagger: 0.08, duration: 0.4, ease: 'power2.out'
}, '-=0.2');

// Project cards fly in
heroTl.from('.project-card', {
  x: 60, opacity: 0, rotateY: 12,
  stagger: { amount: 0.4, from: 'start' },
  duration: 0.7,
  ease: 'power3.out',
}, '-=0.8');

// ─── Floating Project Cards ───
gsap.utils.toArray<HTMLElement>('.project-card').forEach((card, i) => {
  gsap.to(card, {
    y: -6,
    duration: 2 + i * 0.3,
    repeat: -1,
    yoyo: true,
    ease: 'sine.inOut',
    delay: i * 0.4,
  });
});

// ─── Section header stagger ───
document.querySelectorAll<HTMLElement>('.section-header').forEach(header => {
  const children = Array.from(header.children);
  gsap.from(children, {
    scrollTrigger: { trigger: header, start: 'top 80%' },
    y: 30, opacity: 0,
    stagger: 0.12,
    duration: 0.7,
    ease: 'power3.out',
  });
});

// ─── MacBook float ───
gsap.to('.macbook', {
  y: -12,
  duration: 3.5,
  repeat: -1,
  yoyo: true,
  ease: 'sine.inOut',
});

// ─── CTA Banner text ───
gsap.from('.cta-title', {
  scrollTrigger: { trigger: '.cta-banner', start: 'top 75%' },
  y: 30, opacity: 0, duration: 0.8, ease: 'power3.out',
});
gsap.from('.cta-desc', {
  scrollTrigger: { trigger: '.cta-banner', start: 'top 75%' },
  y: 20, opacity: 0, duration: 0.7, delay: 0.15, ease: 'power2.out',
});
gsap.from('.cta-btn', {
  scrollTrigger: { trigger: '.cta-banner', start: 'top 75%' },
  scale: 0.8, opacity: 0, duration: 0.6, delay: 0.25, ease: 'back.out(2)',
});
</script>
