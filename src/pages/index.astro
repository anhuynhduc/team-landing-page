    color: '#0F2027',
    accent: '#00B09B',
    tag: 'Cloud & Hosting',
    img: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=600&q=80&fit=crop',
  },
  {
    title: 'Organic Farm Store',
    cat: 'Thương mại điện tử',
    desc: 'Giao diện organic, sản phẩm nổi bật, giỏ hàng thông minh & thanh toán online',
    color: '#1B4332',
    accent: '#52B788',
