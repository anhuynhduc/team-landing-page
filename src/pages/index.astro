.service-card-pro:hover .svc-border-bottom { bottom:0; }
.svc-border-bottom { position:absolute; left:0; right:0; bottom:-4px; height:4px; background:linear-gradient(90deg,var(--primary),var(--primary-light)); transition:bottom .35s; }
.svc-icon-wrap { width:60px; height:60px; background:var(--primary-glow); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; color:var(--primary); transition:background .3s,transform .3s; flex-shrink:0; }
.service-card-pro:hover .svc-icon-wrap { background:var(--primary); color:#fff; transform:rotate(-5deg) scale(1.1); }
.service-title { font-size:1.05rem; font-weight:800; line-height:1.2; }
.service-desc { font-size:.875rem; color:var(--text-muted); line-height:1.65; flex:1; }
.service-cta { display:flex; align-items:center; gap:6px; color:var(--primary); font-family:var(--font-heading); font-weight:700; font-size:.85rem; margin-top:8px; transition:gap .2s; }
.service-card-pro:hover .service-cta { gap:10px; }

/* PROCESS */
.process-section { background:var(--bg); }
.process-num { background:linear-gradient(135deg,var(--primary),var(--primary-light)); color:white; }

/* ABOUT */
.about-teaser { background:var(--white); }
.about-teaser-inner { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }
.value-pills { display:flex; flex-wrap:wrap; gap:10px; margin-top:28px; }
.value-pill { display:inline-flex; align-items:center; gap:6px; padding:8px 18px; background:var(--bg); border:2px solid var(--border); border-radius:var(--radius-pill); font-family:var(--font-heading); font-weight:700; font-size:.82rem; color:var(--text); transition:background .3s,border-color .3s,color .3s; }
.value-pill:hover { background:var(--primary); border-color:var(--primary); color:#fff; }
.about-mini-stats { display:flex; align-items:center; gap:24px; margin-top:28px; padding:24px; background:var(--bg); border-radius:var(--radius-md); }
.ams-item { text-align:center; }
.ams-number { display:block; font-family:var(--font-heading); font-weight:900; font-size:1.8rem; color:var(--primary); line-height:1; }
.ams-label { font-size:.75rem; color:var(--text-muted); margin-top:4px; }
.ams-divider { width:1px; height:40px; background:var(--border); }
.about-teaser-visual { position:relative; }
.about-img-wrap { position:relative; border-radius:var(--radius-lg); overflow:visible; }
.about-team-img { width:100%; border-radius:var(--radius-lg); aspect-ratio:4/3; object-fit:cover; box-shadow:var(--shadow-lg); }
.float-card { position:absolute; background:white; border-radius:var(--radius-md); padding:14px 18px; box-shadow:0 12px 40px rgba(0,0,0,.15); display:flex; align-items:center; gap:12px; }
.float-card--1 { bottom:-20px; left:-20px; animation:floatCard 4s ease-in-out infinite; }
.float-card--2 { top:-20px; right:-20px; flex-direction:column; align-items:flex-start; animation:floatCard 4s ease-in-out infinite 1.5s; }
@keyframes floatCard { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
.fc-icon { font-size:1.5rem; }
.fc-title { font-family:var(--font-heading); font-weight:800; font-size:.85rem; }
.fc-sub { font-size:.72rem; color:var(--text-muted); }
.fc-number { font-family:var(--font-heading); font-weight:900; font-size:2rem; color:var(--primary); line-height:1; }
.fc-stars { color:#F59E0B; font-size:.7rem; }
.fc-stat { display:flex; align-items:center; gap:8px; }
.fc-rating-label { font-size:.72rem; color:var(--text-muted); }

/* PORTFOLIO */
.portfolio-section { background:var(--bg); }
.portfolio-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:56px; }
.portfolio-item { border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-sm); transition:transform .35s var(--transition),box-shadow .35s var(--transition); }
.portfolio-item:hover { transform:translateY(-6px); box-shadow:var(--shadow-md); }
.portfolio-meta { background:var(--white); padding:16px; }
.portfolio-cat { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--primary); font-family:var(--font-heading); }
.portfolio-title { font-size:1rem; font-weight:800; margin-top:4px; }
.portfolio-desc-sm { font-size:.78rem; color:var(--text-muted); margin-top:4px; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.portfolio-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,.7),transparent); display:flex; align-items:flex-end; justify-content:center; padding-bottom:16px; opacity:0; transition:opacity .35s; }
.portfolio-overlay span { color:#fff; font-family:var(--font-heading); font-weight:700; font-size:.9rem; }
.portfolio-item:hover .portfolio-overlay { opacity:1; }

/* ĐỒ ÁN CNTT */
.academic-section { background:var(--white); }
.academic-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:56px; }
.academic-card { background:var(--bg); border-radius:var(--radius-md); padding:30px 26px; border:2px solid transparent; transition:transform .35s var(--transition),border-color .35s,box-shadow .35s; }
.academic-card:hover { transform:translateY(-8px); border-color:var(--primary-light); box-shadow:var(--shadow-md); }
.ac-icon { width:54px; height:54px; border-radius:var(--radius-sm); background:var(--primary-glow); color:var(--primary); display:flex; align-items:center; justify-content:center; transition:background .3s,color .3s; }
.academic-card:hover .ac-icon { background:var(--primary); color:#fff; }
.ac-title { font-size:1.05rem; font-weight:800; margin-top:18px; }
.ac-tech { display:inline-block; margin-top:8px; font-family:var(--font-heading); font-weight:600; font-size:.72rem; color:var(--primary); letter-spacing:.02em; }
.ac-desc { font-size:.85rem; color:var(--text-muted); line-height:1.65; margin-top:10px; }
.academic-flow { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:48px; }
.af-step { display:flex; gap:14px; align-items:flex-start; padding:20px; background:var(--bg); border-radius:var(--radius-md); }
.af-num { font-family:var(--font-heading); font-weight:900; font-size:1.4rem; color:var(--primary); opacity:.55; line-height:1; flex-shrink:0; }
.af-title { font-size:.95rem; font-weight:800; }
.af-desc { font-size:.78rem; color:var(--text-muted); line-height:1.55; margin-top:5px; }
.academic-note { display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-top:40px; padding:28px 32px; border-radius:var(--radius-md); background:linear-gradient(135deg,var(--primary-glow),rgba(78,205,196,.12)); }
.an-text { font-size:.95rem; color:var(--text); line-height:1.6; max-width:560px; }
.an-text strong { color:var(--primary-dark); }

/* TESTIMONIALS */
.testi-section { background:var(--bg); }

/* BLOG */
.blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; margin-top:48px; }
.blog-card { display:flex; flex-direction:column; }
.blog-card-body { padding:20px; display:flex; flex-direction:column; flex:1; }
.blog-date { font-size:.78rem; color:var(--text-light); font-family:var(--font-heading); font-weight:600; }
.blog-title { font-size:1rem; font-weight:800; margin-top:8px; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.blog-excerpt { font-size:.85rem; color:var(--text-muted); line-height:1.65; margin-top:10px; flex:1; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
.blog-read-more { color:var(--primary); font-family:var(--font-heading); font-weight:700; font-size:.85rem; margin-top:16px; display:inline-flex; align-items:center; gap:4px; transition:gap .2s; }
.blog-read-more:hover { gap:8px; }

/* CTA */
.cta-banner { background:linear-gradient(135deg,var(--primary),#4ECDC4 60%,#96C93D); padding:80px 0; position:relative; overflow:hidden; }
.cta-bg-anim { position:absolute; inset:0; pointer-events:none; }
.cta-blob { position:absolute; border-radius:50%; filter:blur(60px); opacity:.3; }
.cta-blob--1 { width:400px; height:400px; background:#fff; top:-150px; left:-100px; animation:blobFloat 6s ease-in-out infinite; }
.cta-blob--2 { width:300px; height:300px; background:#96C93D; bottom:-100px; right:-80px; animation:blobFloat 8s ease-in-out infinite reverse; }
@keyframes blobFloat { 0%,100%{transform:translate(0,0)} 50%{transform:translate(20px,-20px)} }
.cta-inner { display:flex; align-items:center; justify-content:space-between; gap:40px; flex-wrap:wrap; position:relative; }
.cta-title { font-size:clamp(1.5rem,3vw,2.4rem); color:#fff; font-weight:900; line-height:1.2; }
.cta-desc { font-size:1rem; color:rgba(255,255,255,.85); margin-top:12px; }
.cta-actions { display:flex; align-items:center; gap:20px; flex-shrink:0; flex-wrap:wrap; }
.cta-btn { font-size:1.05rem; padding:16px 40px; }
.cta-phone-link { display:flex; align-items:center; gap:8px; color:rgba(255,255,255,.9); font-family:var(--font-heading); font-weight:700; font-size:1rem; transition:color .2s; }
.cta-phone-link:hover { color:#fff; }

/* RESPONSIVE */
@media (max-width:1024px) {
  .hero-inner { grid-template-columns:1fr; gap:48px; }
  .hero-visual { max-width:520px; }
  .about-teaser-inner { grid-template-columns:1fr; gap:48px; }
  .about-teaser-visual { display:none; }
  .stats-inner { grid-template-columns:repeat(2,1fr); padding:48px 24px; }
  .stat-item { border-right:none; border-bottom:1px solid rgba(255,255,255,.2); }
  .stat-item:nth-child(3),.stat-item:nth-child(4) { border-bottom:none; }
  .portfolio-grid { grid-template-columns:repeat(2,1fr); }
  .blog-grid { grid-template-columns:repeat(2,1fr); }
  .services-grid-6 { grid-template-columns:repeat(2,1fr); }
  .academic-grid { grid-template-columns:repeat(2,1fr); }
  .academic-flow { grid-template-columns:repeat(2,1fr); }
}
@media (max-width:768px) {
  .hero-title { font-size:clamp(1.7rem,5vw,2.5rem); }
  .hero-desc { margin-top:16px; }
  .hero-actions { gap:12px; margin-top:24px; }
  .cta-inner { flex-direction:column; text-align:center; justify-content:center; }
  .cta-actions { justify-content:center; }
  .testi-grid { grid-template-columns:1fr; }
}
@media (max-width:640px) {
  .hero-inner { gap:24px; }
  .hero-trust { gap:10px 20px; margin-top:32px; }
  .hero-visual { max-width:420px; }
  .stats-inner { grid-template-columns:1fr; padding:40px 16px; }
  .stat-item { border-bottom:1px solid rgba(255,255,255,.2); }
  .stat-item:last-child { border-bottom:none; }
  .portfolio-grid { grid-template-columns:1fr; }
  .blog-grid { grid-template-columns:1fr; }
  .services-grid-6 { grid-template-columns:1fr; }
  .academic-grid { grid-template-columns:1fr; }
  .academic-flow { grid-template-columns:1fr; }
  .academic-note { flex-direction:column; align-items:flex-start; }
  .process-grid { grid-template-columns:1fr; gap:24px; }
  .process-grid::before { display:none; }
}
</style>

<script>
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
gsap.registerPlugin(ScrollTrigger);

// Hero particles canvas
(function() {
  const canvas = document.getElementById("heroCanvas");
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  let W = canvas.offsetWidth, H = canvas.offsetHeight;
  canvas.width = W; canvas.height = H;
  const N = 50;
  const pts = Array.from({length:N}, () => ({
    x: Math.random()*W, y: Math.random()*H,
    r: Math.random()*2+0.5,
    vx: (Math.random()-.5)*.35,
    vy: (Math.random()-.5)*.35,
    a: Math.random()*.35+.08
  }));
  let raf;
  function draw() {
    ctx.clearRect(0,0,W,H);
    pts.forEach(p => {
      p.x+=p.vx; p.y+=p.vy;
      if(p.x<0)p.x=W; if(p.x>W)p.x=0;
      if(p.y<0)p.y=H; if(p.y>H)p.y=0;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle=`rgba(0,176,155,${p.a})`; ctx.fill();
    });
    pts.forEach((a,i) => {
      pts.slice(i+1).forEach(b => {
        const d=Math.hypot(a.x-b.x,a.y-b.y);
        if(d<100) {
          ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
          ctx.strokeStyle=`rgba(0,176,155,${.07*(1-d/100)})`; ctx.lineWidth=.5; ctx.stroke();
        }
      });
    });
    raf=requestAnimationFrame(draw);
  }
  draw();
  window.addEventListener("resize",()=>{
    cancelAnimationFrame(raf); W=canvas.offsetWidth; H=canvas.offsetHeight;
    canvas.width=W; canvas.height=H; draw();
  });
})();

// Hero entrance
const tl = gsap.timeline({delay:.5});
tl.from(".hero-label",{y:20,opacity:0,duration:.6,ease:"power3.out"})
  .from(".hero-title-line > span",{y:"110%",stagger:.1,duration:.8,ease:"power4.out"},"-=.3")
  .from(".hero-desc",{y:20,opacity:0,duration:.6,ease:"power2.out"},"-=.4")
  .from(".hero-actions > *",{y:20,opacity:0,stagger:.1,duration:.5,ease:"power2.out"},"-=.3")
  .from(".trust-item",{y:15,opacity:0,stagger:.08,duration:.4,ease:"power2.out"},"-=.2")
  .from(".hero-visual .hv-scene",{scale:.9,opacity:0,duration:.9,ease:"power3.out"},"-=.8")
  .from(".hero-visual .hv-badge",{scale:0,opacity:0,stagger:.1,duration:.6,ease:"back.out(2)"},"-=.5");

// Stats counter
document.querySelectorAll("[data-counter]").forEach(el=>{
  const target=parseInt(el.dataset.counter||"0");
  const suffix=el.dataset.suffix||"";
  ScrollTrigger.create({trigger:el,start:"top 80%",once:true,onEnter:()=>{
    const obj={val:0};
    gsap.to(obj,{val:target,duration:2.2,ease:"power2.out",
      onUpdate(){el.textContent=Math.round(obj.val)+suffix;},
      onComplete(){el.textContent=target+suffix;}
    });
  }});
});

// Process steps
document.querySelectorAll(".process-step").forEach((step,i)=>{
  gsap.from(step,{scrollTrigger:{trigger:step,start:"top 85%"},y:50,opacity:0,duration:.7,delay:i*.15,ease:"power3.out"});
  gsap.from(step.querySelector(".process-num"),{scrollTrigger:{trigger:step,start:"top 85%"},scale:0,rotation:-20,duration:.7,delay:i*.15+.2,ease:"back.out(2)"});
});

// Services reveal
document.querySelectorAll(".service-card-pro").forEach((c,i)=>{
  gsap.from(c,{scrollTrigger:{trigger:c,start:"top 85%"},y:40,opacity:0,duration:.6,delay:(i%3)*.1,ease:"power3.out"});
});

// About text
gsap.from(".about-teaser-text > *",{scrollTrigger:{trigger:".about-teaser",start:"top 75%"},y:30,opacity:0,stagger:.12,duration:.7,ease:"power3.out"});

// Academic project cards
document.querySelectorAll(".academic-card").forEach((c,i)=>{
  gsap.from(c,{scrollTrigger:{trigger:c,start:"top 85%"},y:40,opacity:0,duration:.6,delay:(i%3)*.1,ease:"power3.out"});
});
document.querySelectorAll(".af-step").forEach((s,i)=>{
  gsap.from(s,{scrollTrigger:{trigger:s,start:"top 88%"},y:30,opacity:0,duration:.5,delay:(i%4)*.08,ease:"power2.out"});
});

// Portfolio
document.querySelectorAll(".portfolio-item").forEach((item,i)=>{
  gsap.from(item,{scrollTrigger:{trigger:item,start:"top 85%"},y:50,opacity:0,duration:.6,delay:(i%4)*.1,ease:"power3.out"});
});

// Testimonials
document.querySelectorAll(".testi-card").forEach((c,i)=>{
  gsap.from(c,{scrollTrigger:{trigger:c,start:"top 85%"},x:i%2===0?-40:40,opacity:0,duration:.7,ease:"power3.out"});
});

// Blog cards
document.querySelectorAll(".blog-card").forEach((c,i)=>{
  gsap.from(c,{scrollTrigger:{trigger:c,start:"top 88%"},y:40,opacity:0,duration:.6,delay:i*.1,ease:"power3.out"});
});

// CTA
gsap.from(".cta-title",{scrollTrigger:{trigger:".cta-banner",start:"top 75%"},y:30,opacity:0,duration:.8,ease:"power3.out"});
gsap.from(".cta-desc",{scrollTrigger:{trigger:".cta-banner",start:"top 75%"},y:20,opacity:0,duration:.7,delay:.15,ease:"power2.out"});
gsap.from(".cta-actions",{scrollTrigger:{trigger:".cta-banner",start:"top 75%"},scale:.9,opacity:0,duration:.6,delay:.25,ease:"back.out(2)"});

// Parallax hero
gsap.to(".hero-bg-shape",{scrollTrigger:{trigger:".hero",start:"top top",end:"bottom top",scrub:1},y:-150,scale:1.1});

</script>
