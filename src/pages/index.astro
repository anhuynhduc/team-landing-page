    img: 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=600&q=80&fit=crop',
  },
  {
    title: 'Catapult Coin',
    cat: 'Tài chính & Blockchain',
    desc: 'Nền tảng đầu tư tiền điện tử, dashboard realtime, bảo mật đa lớp',
    color: '#1C1C3A',
    accent: '#6C63FF',
    tag: 'Blockchain',
    img: 'https://images.unsplash.com/photo-1639762681485-074b7f938ba0?w=600&q=80&fit=crop',
  },
  {
    title: 'Luxe Beauty Spa',
    cat: 'Làm đẹp & Wellness',
    desc: 'Thiết kế sang trọng, tone pastel, đặt lịch online tích hợp CRM khách hàng',
    color: '#4A1942',
    accent: '#F9A8D4',
    tag: 'Beauty & Spa',
    img: 'https://images.unsplash.com/photo-1560066984-138dadb4c035?w=600&q=80&fit=crop',
  },
];

const services = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Thiết Kế Website',
    desc: 'Giao diện chuẩn UX/UI, responsive hoàn hảo trên mọi thiết bị, tốc độ tải trang vượt trội và thân thiện với Google.',
    href: '/dich-vu/thiet-ke-website',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: 'Dịch Vụ SEO',
    desc: 'Tối ưu từ khóa chiến lược, xây dựng backlink chất lượng, đưa website lên top Google bền vững và tăng trưởng organic.',
    href: '/dich-vu/seo',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: 'Mobile App',
    desc: 'Phát triển ứng dụng iOS & Android với trải nghiệm người dùng vượt trội, hiệu năng cao và dễ maintain.',
    href: '/dich-vu/mobile-app',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>`,
    title: 'Digital Marketing',
    desc: 'Chiến lược quảng cáo đa kênh: Google Ads, Facebook Ads, TikTok Ads — đúng tệp khách hàng, tối ưu ROI liên tục.',
    href: '/dich-vu',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Hosting & Bảo Mật',
    desc: 'Hosting tốc độ cao NVMe SSD, CDN toàn cầu, SSL miễn phí, backup tự động, uptime 99.99% đảm bảo.',
    href: '/dich-vu',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Quản Trị & Bảo Trì',
    desc: 'Theo dõi hiệu suất 24/7, cập nhật nội dung, backup định kỳ và tối ưu hóa website liên tục sau bàn giao.',
    href: '/dich-vu',
  },
];

const stats = [
  { number: 850, suffix: '+', label: 'Dự án hoàn thành' },
  { number: 12,  suffix: ' năm', label: 'Kinh nghiệm thực chiến' },
  { number: 620, suffix: '+', label: 'Khách hàng tin tưởng' },
  { number: 98,  suffix: '%', label: 'Tỷ lệ hài lòng' },
];

const techs = [
  'React', 'Next.js', 'Vue.js', 'Node.js', 'WordPress', 'Laravel',
  'AWS Cloud', 'Docker', 'Shopify', 'Firebase', 'TypeScript', 'Figma',
];

const processes = [
  {
    step: '01',
    title: 'Tư Vấn & Phân Tích',
    desc: 'Lắng nghe mục tiêu kinh doanh, phân tích đối thủ và đề xuất giải pháp phù hợp nhất.',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    step: '02',
    title: 'Thiết Kế UI/UX',
    desc: 'Wireframe, prototype và thiết kế giao diện theo thương hiệu, đảm bảo trải nghiệm người dùng tối ưu.',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
  },
  {
    step: '03',
    title: 'Phát Triển & Testing',
    desc: 'Lập trình với công nghệ hiện đại, kiểm thử toàn diện trên mọi thiết bị và trình duyệt.',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    step: '04',
    title: 'Ra Mắt & Hỗ Trợ',
    desc: 'Deploy production, training nhân viên và hỗ trợ kỹ thuật 24/7 trong suốt quá trình vận hành.',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  },
];

const testimonials = [
  {
    name: 'Nguyễn Anh Tiến',
    role: 'CEO, Công ty TNHH Phú Mỹ Giàu Đẹp',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=120&q=80&fit=crop&crop=face',
    content: 'PMGĐ muốn xây dựng kênh rao vặt bất động sản trung gian. Global Tech đã hiểu ngay yêu cầu và triển khai website với đầy đủ tính năng vượt trội trong thời gian ngắn. Hiệu quả vượt ngoài mong đợi của chúng tôi.',
    project: 'Website BĐS trung gian',
    stars: 5,
  },
  {
    name: 'Trần Văn Thành',
    role: 'Tổng Giám Đốc, RINO Super App',
    avatar: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=120&q=80&fit=crop&crop=face',
    content: 'RINO cần một website chuyên nghiệp để giới thiệu ứng dụng giao hàng. Nhờ Global Tech, lượt tải app tăng trưởng 3x chỉ sau 2 tháng ra mắt. Giao diện đẹp tạo ấn tượng mạnh với đối tác và nhà đầu tư.',
    project: 'Website giới thiệu app RINO',
    stars: 5,
  },
  {
    name: 'Lê Thanh Mai',
    role: 'Founder, MINIGA Boutique',
    avatar: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=120&q=80&fit=crop&crop=face',
    content: 'Sau đại dịch tôi quyết định chuyển sang bán hàng online. Global Tech đã xây dựng website thương mại điện tử ấn tượng, khác biệt so với đối thủ. Doanh thu tăng 40% chỉ sau 3 tháng nhờ kênh online.',
    project: 'E-commerce MINIGA',
    stars: 5,
  },
  {
    name: 'Phạm Minh Khoa',
    role: 'Giám Đốc, Phong Thủy Tâm An',
    avatar: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?w=120&q=80&fit=crop&crop=face',
    content: 'Đội ngũ đã hiểu được tư tưởng và triết lý thương hiệu của chúng tôi, tạo ra website không chỉ đẹp về giao diện mà còn truyền tải được tinh thần của ngành phong thủy. Khách hàng rất ấn tượng.',
    project: 'Website Phong Thủy Tâm An',
    stars: 5,
  },
];

const blogs = [
  {
    date: '27/04/2026',
    cat: 'SEO & Content',
    title: 'Table of Contents là gì? Hướng dẫn tạo mục lục chuẩn SEO cho website',
    excerpt: 'Các bài viết dài cần Table of Contents để cải thiện UX và tăng điểm E-E-A-T với Google. Hướng dẫn chi tiết cách triển khai hiệu quả nhất hiện nay.',
    img: 'https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?w=600&q=80&fit=crop',
  },
  {
    date: '20/04/2026',
    cat: 'Thiết kế Web',
    title: 'Elementor Pro vs Bricks Builder: So sánh toàn diện 2026',
    excerpt: 'Hai page builder hàng đầu WordPress đang cạnh tranh rất gay gắt. Phân tích chi tiết hiệu suất, tính năng và khả năng SEO để bạn chọn đúng công cụ.',
    img: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=600&q=80&fit=crop',
  },
  {
    date: '15/04/2026',
    cat: 'Digital Marketing',
    title: 'Google Knowledge Graph 2026: Cách tối ưu Entity SEO hiệu quả',
    excerpt: 'Knowledge Graph của Google ngày càng quan trọng trong kỷ nguyên AI Search. Chiến lược Entity SEO giúp thương hiệu xuất hiện nổi bật trên SERP.',
    img: 'https://images.unsplash.com/photo-1432888622747-4eb9a8f5a07d?w=600&q=80&fit=crop',
  },
];
---

<BaseLayout title="Global Tech – Thiết Kế Website & Giải Pháp Marketing Số Chuyên Nghiệp">

  <!-- HERO -->
  <section class="hero">
    <canvas id="heroCanvas"></canvas>
    <div class="hero-bg-shape"></div>
    <div class="hero-bg-dots"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="hero-label"><span class="label">Giải Pháp Số Toàn Diện</span></div>
        <h1 class="hero-title">
          <span class="hero-title-line clip-word"><span>Thiết Kế</span></span>
          <span class="hero-title-line clip-word"><span>Website &</span></span>
          <span class="hero-title-line clip-word hero-title-accent"><span>Marketing</span></span>
          <span class="hero-title-line clip-word hero-title-accent"><span>Toàn Diện</span></span>
        </h1>
        <p class="hero-desc">Hơn 850 dự án đã hoàn thành, Global Tech là đối tác tin cậy giúp doanh nghiệp xây dựng hình ảnh số mạnh mẽ — từ thiết kế website, SEO đến chiến lược marketing đa kênh.</p>
        <div class="hero-actions">
          <a href="/dich-vu" class="btn-primary hero-cta magnetic">Khám phá dịch vụ <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          <a href="/lien-he" class="btn-outline magnetic">Tư vấn miễn phí</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item"><span class="trust-icon">✅</span><span>Cam kết chất lượng</span></div>
          <div class="trust-item"><span class="trust-icon">⚡</span><span>Bàn giao đúng hạn</span></div>
          <div class="trust-item"><span class="trust-icon">🔒</span><span>Bảo hành 12 tháng</span></div>
        </div>
      </div>
      <div class="hero-grid">
        {projects.map((p, i) => (
          <a href="/du-an" class="project-card" style={`--card-color: ${p.color}; --card-accent: ${p.accent};`}>
            <div class="project-card-inner">
              <div class="project-img-wrap">
                <img src={p.img} alt={p.title} loading={i < 2 ? "eager" : "lazy"} />
                <div class="project-img-overlay">
                  <span class="project-tag" style={`background:${p.accent}33; color:${p.accent}`}>{p.tag}</span>
                </div>
              </div>
              <div class="project-info">
                <h3 class="project-title">{p.title}</h3>
                <p class="project-desc">{p.desc}</p>
              </div>
              <div class="project-hover-overlay"><span>Xem dự án →</span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="hero-scroll-hint"><div class="scroll-ball"></div></div>
  </section>

  <!-- STATS -->
  <section class="stats-section">
    <div class="stats-inner">
      {stats.map((s) => (
        <div class="stat-item">
          <span class="stat-number" data-counter={s.number} data-suffix={s.suffix}>{s.number}{s.suffix}</span>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TECH MARQUEE -->
  <div class="marquee-section">
    <div class="marquee-label"><span class="label">Công nghệ chúng tôi sử dụng</span></div>
    <div class="marquee-wrapper">
      <div class="marquee-track">
        <div class="marquee-set">
          {techs.map(t => (
            <span class="tech-pill"><span class="tech-pill-dot"></span>{t}</span>
          ))}
        </div>
        <div class="marquee-set" aria-hidden="true">
          {techs.map(t => (
            <span class="tech-pill"><span class="tech-pill-dot"></span>{t}</span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <span class="label anim-fade-up">Những Gì Chúng Tôi Làm</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">Giải Pháp Dịch Vụ<br><span class="text-teal">Toàn Diện</span></h2>
        <p class="section-desc anim-fade-up" style="margin:20px auto 0">Đầy đủ các dịch vụ công nghệ và marketing — từ một điểm đến, bạn nhận được toàn bộ hệ sinh thái số cần thiết để phát triển bền vững.</p>
      </div>
      <div class="services-grid-6">
        {services.map((svc) => (
          <a href={svc.href} class="service-card-pro">
            <div class="svc-icon-wrap"><Fragment set:html={svc.icon} /></div>
            <h3 class="service-title">{svc.title}</h3>
            <p class="service-desc">{svc.desc}</p>
            <span class="service-cta">Xem chi tiết <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            <div class="svc-border-bottom"></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="label anim-fade-up">Quy Trình Làm Việc</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">4 Bước Đến<br><span class="text-teal">Thành Công</span></h2>
        <p class="section-desc anim-fade-up" style="margin:20px auto 0">Quy trình chuẩn hóa giúp đảm bảo mỗi dự án được triển khai đúng tiến độ, đúng chất lượng và đúng mục tiêu kinh doanh.</p>
      </div>
      <div class="process-grid">
        {processes.map((p, i) => (
          <div class="process-step">
            <div class="process-num"><Fragment set:html={p.icon} /></div>
            <h3 class="process-title">{p.title}</h3>
            <p class="process-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="section about-teaser">
    <div class="container about-teaser-inner">
      <div class="about-teaser-text">
        <span class="label anim-fade-up">Về Chúng Tôi</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">Đội Ngũ Chiến Binh<br><span class="text-teal">Công Nghệ</span></h2>
        <p class="section-desc anim-fade-up" style="margin-top:20px">Hơn 12 năm đồng hành cùng hàng trăm doanh nghiệp — từ startup đến tập đoàn — chúng tôi không chỉ xây dựng website mà kiến tạo cả một hệ sinh thái số giúp thương hiệu bứt phá.</p>
        <div class="value-pills anim-fade-up">
          {["🎯 Sáng Tạo", "💡 12 Năm KN", "🤝 Thấu Hiểu", "🌐 Đa Nền Tảng"].map(v => (
            <span class="value-pill">{v}</span>
          ))}
        </div>
        <div class="about-mini-stats anim-fade-up">
          <div class="ams-item"><span class="ams-number">850+</span><span class="ams-label">Dự án</span></div>
          <div class="ams-divider"></div>
          <div class="ams-item"><span class="ams-number">620+</span><span class="ams-label">Khách hàng</span></div>
          <div class="ams-divider"></div>
          <div class="ams-item"><span class="ams-number">98%</span><span class="ams-label">Hài lòng</span></div>
        </div>
        <a href="/gioi-thieu" class="btn-primary anim-fade-up magnetic" style="margin-top:32px">Tìm hiểu về chúng tôi</a>
      </div>
      <div class="about-teaser-visual anim-scale">
        <div class="about-img-wrap">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80&fit=crop" alt="Đội ngũ Global Tech" class="about-team-img" loading="lazy" />
          <div class="float-card float-card--1">
            <div class="fc-icon">🚀</div>
            <div class="fc-content">
              <div class="fc-title">Dự án mới</div>
              <div class="fc-sub">VNG Cloud Platform</div>
            </div>
          </div>
          <div class="float-card float-card--2">
            <div class="fc-stat"><span class="fc-number">4.9</span><div class="fc-stars">★★★★★</div></div>
            <div class="fc-rating-label">Đánh giá từ khách hàng</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section class="section portfolio-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="label anim-fade-up">Dự Án Nổi Bật</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">Những Công Trình<br><span class="text-teal">Chúng Tôi Tự Hào</span></h2>
        <p class="section-desc anim-fade-up" style="margin:16px auto 0">Mỗi dự án là một hành trình sáng tạo — từ ý tưởng đến sản phẩm hoàn chỉnh đã tạo nên giá trị thực sự cho doanh nghiệp.</p>
      </div>
      <div class="portfolio-grid">
        {projects.map((p) => (
          <a href="/du-an" class="portfolio-item" style={`--pa:${p.accent}; --pc:${p.color}`}>
            <div class="port-img-wrap">
              <img src={p.img} alt={p.title} loading="lazy" />
              <div class="portfolio-overlay"><span>Xem chi tiết →</span></div>
            </div>
            <div class="portfolio-meta">
              <span class="portfolio-cat">{p.cat}</span>
              <h3 class="portfolio-title">{p.title}</h3>
              <p class="portfolio-desc-sm">{p.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center" style="margin-top:48px">
        <a href="/du-an" class="btn-outline anim-fade-up magnetic">Xem tất cả dự án</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section testi-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="label anim-fade-up">Khách Hàng Nói Gì</span>
        <h2 class="section-title anim-fade-up" style="margin-top:12px">Niềm Tin Từ<br><span class="text-teal">Đối Tác</span></h2>
        <p class="section-desc anim-fade-up" style="margin:16px auto 0">Hơn 620 doanh nghiệp đã lựa chọn chúng tôi. Đây là những gì họ chia sẻ sau khi hợp tác.</p>
      </div>
