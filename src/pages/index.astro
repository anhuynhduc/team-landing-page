<style>
/* HERO */
.hero { min-height:100vh; padding:calc(var(--header-h) + 48px) 0 80px; position:relative; overflow:hidden; display:flex; flex-direction:column; justify-content:center; }
#heroCanvas { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; z-index:0; }
.hero-bg-shape { position:absolute; top:-20%; right:-10%; width:60%; height:130%; background:linear-gradient(135deg,#00B09B18,#4ECDC420,transparent 70%); border-radius:40% 60% 60% 40%/40% 50% 50% 60%; pointer-events:none; }
.hero-bg-dots { position:absolute; inset:0; background-image:radial-gradient(circle,#00B09B18 1.5px,transparent 1.5px); background-size:36px 36px; pointer-events:none; mask-image:radial-gradient(ellipse at 80% 50%,black 30%,transparent 70%); }
.hero-inner { display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; position:relative; z-index:1; }
.hero-label { margin-bottom:20px; }
.hero-title { font-size:clamp(2rem,3.8vw,3rem); font-weight:900; line-height:1.1; text-transform:uppercase; letter-spacing:.01em; }
.hero-title-line { display:block; overflow:hidden; padding:0.14em 0; margin:-0.06em 0; }
.hero-title-line > span { display:block; }
.hero-title-accent > span { color:var(--primary); }
.hero-desc { margin-top:24px; font-size:1rem; color:var(--text-muted); line-height:1.75; max-width:460px; }
.hero-actions { display:flex; gap:16px; margin-top:36px; flex-wrap:wrap; align-items:center; }
.hero-cta { font-size:1rem; padding:16px 36px; }
.hero-trust { display:flex; gap:24px; margin-top:32px; flex-wrap:wrap; }
.trust-item { display:flex; align-items:center; gap:8px; font-size:.82rem; font-family:var(--font-heading); font-weight:600; color:var(--text-muted); }

/* Hero visual (illustration) */
.hero-visual { position:relative; width:100%; max-width:600px; margin:0 auto; aspect-ratio:600/470; }
.hv-blob { position:absolute; inset:6% 4% 12% 6%; background:linear-gradient(135deg,#A6E3DA,#CFEFE9 70%); border-radius:46% 54% 58% 42%/50% 44% 56% 50%; filter:blur(2px); opacity:.85; animation:hvBlob 9s ease-in-out infinite; }
@keyframes hvBlob { 0%,100%{border-radius:46% 54% 58% 42%/50% 44% 56% 50%} 50%{border-radius:56% 44% 48% 52%/44% 56% 44% 56%} }
.hv-scene { position:relative; width:100%; height:100%; z-index:1; }
.hv-badge { position:absolute; z-index:2; width:58px; height:58px; background:#fff; border-radius:16px; box-shadow:0 14px 34px rgba(15,40,55,.14); display:flex; align-items:center; justify-content:center; }
.hv-badge--react { top:50%; left:-2%; animation:hvFloat 4.5s ease-in-out infinite; }
.hv-badge--php   { top:22%; left:6%;  animation:hvFloat 5.2s ease-in-out infinite .4s; }
.hv-badge--java  { top:6%;  right:4%; animation:hvFloat 4.8s ease-in-out infinite .8s; }
.hv-badge--js    { top:30%; right:0%; width:48px; height:48px; border-radius:13px; animation:hvFloat 5.5s ease-in-out infinite .2s; }
.hv-badge--css   { top:46%; right:10%; width:48px; height:48px; border-radius:13px; animation:hvFloat 4.2s ease-in-out infinite .6s; }
@keyframes hvFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
.hv-php { font-family:var(--font-body); font-weight:800; font-style:italic; font-size:1rem; color:#777BB4; letter-spacing:-.02em; }
.hv-js  { font-family:var(--font-heading); font-weight:900; font-size:.85rem; color:#fff; background:#F4B740; width:30px; height:30px; border-radius:7px; display:flex; align-items:center; justify-content:center; }
.hv-css { font-family:var(--font-heading); font-weight:900; font-size:.7rem; color:#fff; background:#3F78C4; width:32px; height:30px; border-radius:7px; display:flex; align-items:center; justify-content:center; }

/* Scroll hint */
.hero-scroll-hint { position:absolute; bottom:30px; left:50%; transform:translateX(-50%); width:28px; height:46px; border:2px solid rgba(0,176,155,.3); border-radius:14px; display:flex; justify-content:center; padding-top:6px; z-index:1; }
.scroll-ball { width:6px; height:6px; background:var(--primary); border-radius:50%; animation:scrollBall 2s ease-in-out infinite; }
@keyframes scrollBall { 0%{transform:translateY(0);opacity:1} 80%{transform:translateY(18px);opacity:0} 100%{transform:translateY(0);opacity:0} }

/* STATS */
.stats-section { background:linear-gradient(135deg,var(--primary),var(--primary-light) 60%,#96C93D); padding:0; }
.stats-inner { max-width:1200px; margin:0 auto; padding:56px 24px; display:grid; grid-template-columns:repeat(4,1fr); }
.stat-item { text-align:center; padding:20px; border-right:1px solid rgba(255,255,255,.2); }
.stat-item:last-child { border-right:none; }
.stat-number { display:block; font-family:var(--font-heading); font-weight:900; font-size:clamp(2.5rem,5vw,3.5rem); color:#fff; line-height:1; }
.stat-label { margin-top:10px; font-size:.85rem; color:rgba(255,255,255,.8); font-family:var(--font-heading); font-weight:500; }

/* MARQUEE SECTION */
.marquee-section { padding:40px 0; background:var(--bg); }
.marquee-label { text-align:center; margin-bottom:20px; }

/* SERVICES 6 grid */
.services-grid-6 { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:56px; }
.service-card-pro { background:var(--white); border-radius:var(--radius-md); padding:36px 28px; position:relative; overflow:hidden; transition:transform .35s var(--transition),box-shadow .35s var(--transition); display:flex; flex-direction:column; gap:12px; box-shadow:var(--shadow-sm); }
