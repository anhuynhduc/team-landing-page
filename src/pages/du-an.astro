---
// src/pages/du-an.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';

const categories = ['Tất cả', 'Website', 'E-commerce', 'Mobile App', 'Landing Page', 'Đồ án CNTT'];

const projects = [
  { title: 'RINO – Siêu Thị Online',     cat: 'Mobile App',   tag: 'Mobile App',   desc: 'App giao hàng siêu tốc trong 10 phút, hoạt động 24/7 tại TP.HCM.',           img: 'https://images.unsplash.com/photo-1604719312566-8912e9227c6a?w=700&q=80&fit=crop' },
  { title: 'Phú Mỹ Giàu Đẹp',            cat: 'Website',      tag: 'Bất động sản', desc: 'Nền tảng bất động sản trung gian kết nối người mua và người bán.',          img: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=700&q=80&fit=crop' },
  { title: 'MINIGA Boutique',            cat: 'E-commerce',   tag: 'E-commerce',   desc: 'Website thương mại điện tử túi xách và phụ kiện thời trang cao cấp.',        img: 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=700&q=80&fit=crop' },
  { title: 'Coin Catapult',              cat: 'Website',      tag: 'Web App',      desc: 'Nền tảng nghiên cứu và theo dõi đầu tư tiền điện tử thời gian thực.',        img: 'https://images.unsplash.com/photo-1639762681485-074b7f938ba0?w=700&q=80&fit=crop' },
  { title: 'Phong Thủy Tâm An',          cat: 'Website',      tag: 'Website',      desc: 'Website phong thủy chuyên nghiệp với giao diện tâm linh tinh tế.',           img: 'https://images.unsplash.com/photo-1545048702-79362596cdc9?w=700&q=80&fit=crop' },
  { title: 'Dining Experience',          cat: 'Website',      tag: 'Nhà hàng',     desc: 'Website nhà hàng fine dining với hệ thống đặt bàn trực tuyến.',              img: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=700&q=80&fit=crop' },
  { title: 'TechCorp Solution',          cat: 'Landing Page', tag: 'Landing Page', desc: 'Landing page chuyển đổi cao cho công ty phần mềm B2B.',                     img: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=700&q=80&fit=crop' },
  { title: 'GreenMart Organic',          cat: 'E-commerce',   tag: 'E-commerce',   desc: 'Siêu thị thực phẩm sạch online với hệ thống quản lý kho thông minh.',        img: 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=700&q=80&fit=crop' },
  { title: 'MediCare Clinic',            cat: 'Website',      tag: 'Y tế',         desc: 'Website phòng khám với tính năng đặt lịch và quản lý bệnh nhân.',            img: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=700&q=80&fit=crop' },
  { title: 'EduLearn Platform',          cat: 'Website',      tag: 'Giáo dục',     desc: 'Nền tảng học trực tuyến với hơn 200 khoá học và 50.000 học viên.',          img: 'https://images.unsplash.com/photo-1501504905252-473c47e087f8?w=700&q=80&fit=crop' },
  { title: 'FitLife Gym',                cat: 'Landing Page', tag: 'Landing Page', desc: 'Landing page và phễu chuyển đổi cho chuỗi phòng gym tại TP.HCM.',            img: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=700&q=80&fit=crop' },
  { title: 'TravelVN',                   cat: 'Website',      tag: 'Du lịch',      desc: 'Cổng thông tin du lịch Việt Nam với booking tour và khách sạn.',            img: 'https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=700&q=80&fit=crop' },
  { title: 'Đồ án Quản Lý Bán Hàng',     cat: 'Đồ án CNTT',   tag: 'C# · SQL',     desc: 'Đồ án tốt nghiệp: phần mềm quản lý bán hàng C# WinForms + SQL Server, kèm báo cáo.', img: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=700&q=80&fit=crop' },
  { title: 'Đồ án Web Đặt Lịch Khám',    cat: 'Đồ án CNTT',   tag: 'PHP · Laravel', desc: 'Đồ án môn học: website đặt lịch khám bệnh bằng Laravel, phân quyền admin/bác sĩ/bệnh nhân.', img: 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?w=700&q=80&fit=crop' },
  { title: 'Đồ án Nhận Diện Khuôn Mặt',  cat: 'Đồ án CNTT',   tag: 'Python · AI',  desc: 'Đồ án AI: điểm danh bằng nhận diện khuôn mặt với Python, OpenCV và mô hình đã huấn luyện.', img: 'https://images.unsplash.com/photo-1535378917042-10a22c95931a?w=700&q=80&fit=crop' },
];
---

<BaseLayout title="Dự Án" description="Khám phá các dự án website, ứng dụng, chiến dịch marketing và đồ án CNTT tiêu biểu mà Global Tech đã thực hiện.">
  <main>

    <!-- Page Hero -->
    <div class="page-hero">
      <div style="position:absolute;top:-60px;right:-60px;width:280px;height:280px;border-radius:50%;border:40px solid rgba(255,255,255,0.06);pointer-events:none;"></div>
      <div class="container" style="position:relative;z-index:1;">
        <div class="label-tag" style="color:rgba(255,255,255,0.7);margin-bottom:12px;" data-hero-animate>DỰ ÁN</div>
        <h1 data-hero-animate>DỰ ÁN TIÊU BIỂU<br/>CHÚNG TÔI ĐÃ THỰC HIỆN</h1>
        <p data-hero-animate>Từ website doanh nghiệp, ứng dụng, chiến dịch marketing đến đồ án CNTT cho sinh viên — mỗi sản phẩm đều được làm chỉn chu và đo được kết quả.</p>
      </div>
    </div>

    <!-- Stats Bar -->
    <div style="background:white;border-bottom:1px solid #f0f0f0;padding:32px 0;">
      <div class="container">
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center;">
          {[
            { number: '850', suffix: '+', label: 'Dự án hoàn thành' },
            { number: '620', suffix: '+', label: 'Khách hàng tin tưởng' },
            { number: '20',  suffix: '+', label: 'Lĩnh vực' },
            { number: '98',  suffix: '%', label: 'Khách hàng hài lòng' },
          ].map(s => (
            <div>
              <div class="stat-number" data-count={s.number} data-suffix={s.suffix}>{s.number}{s.suffix}</div>
              <div class="stat-label" style="margin-top:6px;">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Filter & Projects -->
    <section class="section" style="background:var(--bg-light);">
      <div class="container">

        <!-- Filter -->
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:40px;" id="filterBtns">
          {categories.map((cat, i) => (
            <button
              class="filter-btn"
              data-cat={cat}
              style={`padding:8px 20px;border-radius:50px;font-size:13px;font-weight:600;cursor:pointer;border:2px solid ${i===0?'var(--teal)':'#ddd'};background:${i===0?'var(--teal)':'white'};color:${i===0?'white':'var(--text-mid)'};transition:all 0.3s;`}>
              {cat}
            </button>
          ))}
        </div>

        <!-- Projects Grid -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;" id="projectsGrid">
          {projects.map((p, i) => (
            <div class="project-item card" data-cat={p.cat} data-animate data-delay={String(i%3+1)} style="overflow:hidden;">
              <!-- Preview -->
              <div class="proj-img-wrap">
                <img src={p.img} alt={p.title} loading={i < 3 ? 'eager' : 'lazy'} />
                <span class="proj-tag">{p.tag}</span>
                <div class="overlay">
                  <span style="color:#fff;font-weight:700;font-size:15px;">Xem chi tiết →</span>
                </div>
              </div>
              <!-- Info -->
              <div style="padding:20px;">
                <div style="font-size:11px;font-weight:700;color:var(--teal);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">{p.tag}</div>
                <h3 style="font-size:15px;font-weight:700;color:var(--text-dark);">{p.title}</h3>
                <p style="font-size:13px;color:var(--text-mid);margin-top:6px;line-height:1.6;">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <CTABanner />
  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns  = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.project-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update button styles
        btns.forEach(b => {
          b.style.background   = 'white';
          b.style.color        = 'var(--text-mid)';
          b.style.borderColor  = '#ddd';
        });
        btn.style.background  = 'var(--teal)';
        btn.style.color       = 'white';
        btn.style.borderColor = 'var(--teal)';

        const cat = btn.dataset.cat;
        items.forEach(item => {
          const show = cat === 'Tất cả' || item.dataset.cat === cat;
          item.style.display   = show ? 'block'   : 'none';
          item.style.opacity   = show ? '1'       : '0';
          item.style.transform = show ? 'scale(1)': 'scale(0.95)';
          item.style.transition= 'all 0.35s ease';
        });
      });
    });
  });
</script>

<style>
  .project-item { transition: transform 0.35s ease, box-shadow 0.35s ease; }
  .project-item:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(0,0,0,0.12); }
  .proj-img-wrap { position: relative; height: 200px; overflow: hidden; }
  .proj-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .project-item:hover .proj-img-wrap img { transform: scale(1.08); }
  .proj-tag {
    position: absolute; top: 12px; left: 12px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(4px);
    color: var(--teal);
    font-size: 11px; font-weight: 800;
    letter-spacing: 0.5px;
    padding: 5px 12px;
    border-radius: 50px;
    z-index: 2;
  }
  .proj-img-wrap .overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(26,188,173,0.85), rgba(0,0,0,0.25));
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.35s;
  }
  .project-item:hover .proj-img-wrap .overlay { opacity: 1; }

  @media (max-width: 1024px) {
    #projectsGrid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 640px) {
    #projectsGrid { grid-template-columns: 1fr !important; }
  }
</style>
