---
// src/pages/tuyen-dung.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';

const jobs = [
  { title: 'Senior Web Developer',      type: 'Full-time', location: 'TP.HCM',  salary: '20–35 triệu',  icon: '💻', urgent: true  },
  { title: 'UI/UX Designer',            type: 'Full-time', location: 'TP.HCM',  salary: '15–25 triệu',  icon: '🎨', urgent: true  },
  { title: 'SEO Specialist',            type: 'Full-time', location: 'Remote',   salary: '12–20 triệu',  icon: '🔍', urgent: false },
  { title: 'Content Creator',           type: 'Full-time', location: 'TP.HCM',  salary: '10–18 triệu',  icon: '✍️', urgent: false },
  { title: 'Digital Marketing Manager', type: 'Full-time', location: 'TP.HCM',  salary: '25–40 triệu',  icon: '📊', urgent: false },
  { title: 'React/Astro Frontend Dev',  type: 'Full-time', location: 'Hybrid',   salary: '18–30 triệu',  icon: '⚛️', urgent: true  },
];

const benefits = [
  { icon: '💰', title: 'Lương cạnh tranh',    desc: 'Review lương 2 lần/năm dựa theo năng lực và hiệu quả công việc.' },
  { icon: '📈', title: 'Cơ hội thăng tiến',   desc: 'Lộ trình phát triển sự nghiệp rõ ràng, mentor 1:1 từ senior.' },
  { icon: '🎓', title: 'Đào tạo liên tục',     desc: 'Budget học tập hàng năm, tham gia workshop và conference.' },
  { icon: '🏥', title: 'Bảo hiểm toàn diện',  desc: 'BHXH, BHYT + gói bảo hiểm sức khoẻ bổ sung cho nhân viên.' },
  { icon: '🌴', title: '15 ngày phép/năm',     desc: 'Nghỉ phép linh hoạt + nghỉ sinh nhật + team building hàng quý.' },
  { icon: '🍽️', title: 'Ăn trưa & Snack',     desc: 'Hỗ trợ bữa trưa hàng ngày và góc snack miễn phí tại văn phòng.' },
];
---

<BaseLayout title="Tuyển Dụng" description="Gia nhập đội ngũ MIKO TECH — nơi tài năng được trân trọng và phát triển. Xem các vị trí tuyển dụng hiện có.">
  <main>

    <!-- Hero -->
    <div class="page-hero">
      <div style="position:absolute;top:-40px;right:-40px;width:240px;height:240px;border-radius:50%;border:36px solid rgba(255,255,255,0.07);pointer-events:none;"></div>
      <div class="container" style="position:relative;z-index:1;text-align:center;">
        <div class="label-tag" style="color:rgba(255,255,255,0.7);margin-bottom:12px;" data-hero-animate>TUYỂN DỤNG</div>
        <h1 data-hero-animate>GIA NHẬP ĐỘI NGŨ<br/>MIKO TECH</h1>
        <p data-hero-animate style="max-width:560px;margin:0 auto 24px;">Chúng tôi tìm kiếm những người đam mê công nghệ, sáng tạo và muốn tạo ra sự khác biệt thực sự cho hàng triệu người dùng.</p>
        <div data-hero-animate style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
          <a href="#jobs" class="btn btn-white">Xem vị trí tuyển dụng</a>
          <a href="mailto:tuyendung@mikotech.vn" class="btn" style="background:rgba(255,255,255,0.15);color:white;border-color:rgba(255,255,255,0.3);">tuyendung@mikotech.vn</a>
        </div>
      </div>
    </div>

    <!-- Culture -->
    <section class="section" style="background:white;">
      <div class="container">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
          <div>
            <div data-animate="fade-left" class="label-tag" style="margin-bottom:12px;">VĂN HOÁ CÔNG TY</div>
            <h2 data-animate="fade-left" data-delay="2" class="section-title" style="margin-bottom:20px;">
              Môi Trường <span>Sáng Tạo</span><br/>& Phát Triển
            </h2>
            <p data-animate="fade-left" data-delay="3" style="color:var(--text-mid);font-size:15px;line-height:1.9;margin-bottom:20px;">
              Tại Miko Tech, chúng tôi tin rằng văn hoá công ty là nền tảng của mọi thành công. Chúng tôi xây dựng môi trường mà ở đó mọi ý kiến đều được lắng nghe, mọi nỗ lực đều được ghi nhận và mọi tài năng đều có cơ hội tỏa sáng.
            </p>
            <div data-animate="fade-left" data-delay="4" style="display:flex;gap:24px;">
              <div style="text-align:center;">
                <div class="stat-number" data-count="50" data-suffix="+">0+</div>
                <div class="stat-label" style="margin-top:4px;">Nhân viên</div>
              </div>
              <div style="text-align:center;">
                <div class="stat-number" data-count="4" data-suffix=".8★">0</div>
                <div class="stat-label" style="margin-top:4px;">Rating nội bộ</div>
              </div>
              <div style="text-align:center;">
                <div class="stat-number" data-count="85" data-suffix="%">0%</div>
                <div class="stat-label" style="margin-top:4px;">Giữ chân nhân viên</div>
              </div>
            </div>
          </div>
          <div data-animate="fade-right" data-delay="2" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            {['🎯 Mục tiêu rõ ràng', '💡 Sáng tạo tự do', '🤝 Teamwork mạnh', '🚀 Phát triển nhanh', '❤️ Tôn trọng lẫn nhau', '🏆 Ghi nhận thành tích'].map((item, i) => (
              <div style="background:var(--teal-light);border-radius:12px;padding:20px;font-size:14px;font-weight:600;color:var(--teal);text-align:center;">
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="section" style="background:var(--bg-light);">
      <div class="container">
        <div style="text-align:center;margin-bottom:52px;">
          <div data-animate class="label-tag" style="margin-bottom:12px;">PHÚC LỢI</div>
          <h2 data-animate data-delay="2" class="section-title">Chúng Tôi <span>Quan Tâm</span> Đến Bạn</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
          {benefits.map((b, i) => (
            <div class="card" data-animate data-delay={String(i%3+1)} style="padding:32px;">
              <div style="font-size:36px;margin-bottom:14px;">{b.icon}</div>
              <h3 style="font-size:16px;font-weight:700;color:var(--text-dark);margin-bottom:8px;">{b.title}</h3>
              <p style="font-size:13px;color:var(--text-mid);line-height:1.7;">{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Jobs -->
    <section class="section" id="jobs" style="background:white;">
      <div class="container">
        <div style="text-align:center;margin-bottom:52px;">
          <div data-animate class="label-tag" style="margin-bottom:12px;">CƠ HỘI VIỆC LÀM</div>
          <h2 data-animate data-delay="2" class="section-title">Vị Trí <span>Đang Tuyển</span></h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;">
          {jobs.map((job, i) => (
            <div class="card" data-animate data-delay={String(i%2+1)}
              style="padding:28px 32px;display:flex;align-items:center;gap:24px;justify-content:space-between;flex-wrap:wrap;">
              <div style="display:flex;align-items:center;gap:20px;">
                <div style="width:56px;height:56px;border-radius:14px;background:var(--teal-light);display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;">
                  {job.icon}
                </div>
                <div>
                  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                    <h3 style="font-size:17px;font-weight:700;color:var(--text-dark);">{job.title}</h3>
                    {job.urgent && <span style="background:#fff3cd;color:#856404;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;letter-spacing:0.5px;">URGENT</span>}
                  </div>
                  <div style="display:flex;gap:12px;flex-wrap:wrap;">
                    <span style="font-size:13px;color:var(--text-mid);">📍 {job.location}</span>
                    <span style="font-size:13px;color:var(--text-mid);">⏰ {job.type}</span>
                    <span style="font-size:13px;color:var(--teal);font-weight:600;">💰 {job.salary}</span>
                  </div>
                </div>
              </div>
              <a href="mailto:tuyendung@mikotech.vn" class="btn btn-primary" style="white-space:nowrap;flex-shrink:0;">
                Ứng tuyển ngay →
              </a>
            </div>
          ))}
        </div>

        <div style="text-align:center;margin-top:40px;padding:32px;background:var(--teal-pale);border-radius:16px;" data-animate>
          <p style="font-size:15px;color:var(--text-mid);margin-bottom:16px;">Không thấy vị trí phù hợp? Gửi CV của bạn để chúng tôi lưu hồ sơ!</p>
          <a href="mailto:tuyendung@mikotech.vn" class="btn btn-primary">📧 Gửi CV tự do</a>
        </div>
      </div>
    </section>

    <CTABanner />
  </main>
</BaseLayout>

<style>
  @media (max-width: 1024px) {
    section .container > div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
    section .container > div[style*="grid-template-columns:repeat(3"] { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 640px) {
    section .container > div[style*="grid-template-columns:repeat(3"] { grid-template-columns: 1fr !important; }
  }
</style>
