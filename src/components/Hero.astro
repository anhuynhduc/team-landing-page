---
// src/components/Hero.astro
---

<section class="hero-section">
  <!-- Decorative circles -->
  <div class="deco-circle" style="width:400px;height:400px;top:-100px;right:-100px;"></div>
  <div class="deco-circle" style="width:200px;height:200px;bottom:60px;left:-60px;"></div>
  <div class="deco-circle" style="width:100px;height:100px;top:40%;right:15%;border:2px solid rgba(255,255,255,0.1);background:transparent;"></div>

  <!-- Background big text -->
  <div class="hero-big-text">Xin chào!</div>

  <div class="container" style="position:relative;z-index:1;width:100%;">
    <div style="display:grid;grid-template-columns:1fr 1.2fr;align-items:center;gap:48px;min-height:80vh;padding:120px 0 60px;">

      <!-- LEFT: Text -->
      <div>
        <div data-hero-animate style="margin-bottom:8px;">
          <span class="label-tag" style="color:rgba(255,255,255,0.8);">MIKO TECH</span>
        </div>
        <h1 data-hero-animate style="font-size:clamp(36px,5vw,60px);font-weight:900;color:white;line-height:1.15;margin-bottom:20px;">
          Thiết Kế Website<br/>
          <span style="color:rgba(255,255,255,0.85);">Chuyên Nghiệp &</span><br/>
          Marketing <span style="border-bottom:3px solid rgba(255,255,255,0.6);padding-bottom:2px;">Toàn Diện</span>
        </h1>
        <p data-hero-animate style="font-size:16px;color:rgba(255,255,255,0.82);line-height:1.8;max-width:440px;margin-bottom:36px;">
          Miko Tech đồng hành cùng doanh nghiệp xây dựng và phát triển thương hiệu trên nền tảng kỹ thuật số. Giải pháp sáng tạo, tối ưu và hiệu quả.
        </p>
        <div data-hero-animate style="display:flex;gap:16px;flex-wrap:wrap;">
          <a href="/dich-vu" class="btn btn-white">
            Khám phá dịch vụ
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
          <a href="/lien-he" class="btn" style="background:rgba(255,255,255,0.15);color:white;border-color:rgba(255,255,255,0.3);backdrop-filter:blur(8px);">
            Liên hệ ngay
          </a>
        </div>
      </div>

      <!-- RIGHT: Mockup devices -->
      <div class="hero-mockup" style="position:relative;display:flex;justify-content:center;align-items:center;">
        <!-- Desktop mockup -->
        <div style="background:#1a1a2e;border-radius:16px;padding:10px 10px 6px;box-shadow:0 32px 80px rgba(0,0,0,0.3);max-width:520px;width:100%;">
          <!-- Browser bar -->
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;padding:0 4px;">
            <span style="width:10px;height:10px;border-radius:50%;background:#ff5f56;"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:#ffbd2e;"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:#27c93f;"></span>
            <div style="flex:1;background:rgba(255,255,255,0.1);border-radius:4px;height:18px;margin-left:8px;display:flex;align-items:center;padding:0 8px;">
              <span style="font-size:9px;color:rgba(255,255,255,0.4);">mikotech.vn</span>
            </div>
          </div>
          <!-- Screen content -->
          <div style="background:linear-gradient(135deg,#e8f9f7,#f0fdfb);border-radius:8px;overflow:hidden;height:280px;display:flex;flex-direction:column;">
            <!-- Mini navbar -->
            <div style="background:white;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #eee;">
              <span style="font-size:11px;font-weight:800;color:var(--teal);">MIKO TECH</span>
              <div style="display:flex;gap:12px;">
                <span style="font-size:8px;color:#666;">Trang chủ</span>
                <span style="font-size:8px;color:#666;">Dịch vụ</span>
                <span style="font-size:8px;color:#666;">Liên hệ</span>
              </div>
            </div>
            <!-- Mini hero -->
            <div style="background:var(--teal);flex:1;display:flex;align-items:center;padding:20px;gap:16px;">
              <div>
                <div style="font-size:10px;color:rgba(255,255,255,0.7);margin-bottom:4px;">THIẾT KẾ WEBSITE</div>
                <div style="font-size:14px;font-weight:800;color:white;line-height:1.3;">Giải pháp tối ưu<br/>trải nghiệm người dùng</div>
                <div style="margin-top:10px;background:white;color:var(--teal);font-size:8px;font-weight:700;padding:4px 10px;border-radius:10px;display:inline-block;">Tìm hiểu ngay</div>
              </div>
              <div style="width:80px;height:80px;background:rgba(255,255,255,0.15);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5">
                  <rect x="2" y="3" width="20" height="14" rx="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/>
                  <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
              </div>
            </div>
          </div>
          <!-- Stand -->
          <div style="height:20px;background:#2a2a3e;border-radius:0 0 8px 8px;margin:0;"></div>
          <div style="height:4px;background:#111;width:40%;margin:0 auto;border-radius:0 0 4px 4px;"></div>
        </div>

        <!-- Mobile mockup -->
        <div style="position:absolute;bottom:-20px;left:-20px;background:#1a1a2e;border-radius:20px;padding:6px;box-shadow:0 16px 40px rgba(0,0,0,0.3);width:100px;">
          <!-- Notch -->
          <div style="width:30px;height:5px;background:rgba(255,255,255,0.1);border-radius:3px;margin:4px auto 6px;"></div>
          <!-- Screen -->
          <div style="background:linear-gradient(135deg,var(--teal),var(--teal-dark));border-radius:12px;height:160px;padding:8px;">
            <div style="font-size:6px;font-weight:800;color:white;margin-bottom:4px;">MIKO TECH</div>
            <div style="background:rgba(255,255,255,0.15);border-radius:6px;height:80px;margin-bottom:6px;display:flex;align-items:center;justify-content:center;">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.6">
                <rect x="5" y="2" width="14" height="20" rx="2"/>
              </svg>
            </div>
            <div style="background:rgba(255,255,255,0.2);height:4px;border-radius:2px;margin-bottom:4px;"></div>
            <div style="background:rgba(255,255,255,0.2);height:4px;border-radius:2px;width:70%;"></div>
          </div>
          <!-- Home bar -->
          <div style="width:30px;height:3px;background:rgba(255,255,255,0.2);border-radius:2px;margin:6px auto 4px;"></div>
        </div>

        <!-- Decorative mug -->
        <div style="position:absolute;bottom:-10px;right:-10px;width:60px;height:60px;background:white;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;box-shadow:0 8px 24px rgba(0,0,0,0.2);opacity:0.9;"></div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator">Scroll</div>

  <!-- Wave bottom -->
  <div style="position:absolute;bottom:0;left:0;right:0;overflow:hidden;line-height:0;">
    <svg viewBox="0 0 1440 60" fill="white" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="width:100%;height:60px;">
      <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z"/>
    </svg>
  </div>
</section>

<style>
@media (max-width: 768px) {
  .hero-section > .container > div {
    grid-template-columns: 1fr !important;
    padding: 100px 0 40px !important;
  }
  .hero-section > .container > div > div:last-child {
    display: none;
  }
}
</style>
