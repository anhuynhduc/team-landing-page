---
// src/components/Services.astro

const services = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Thiết Kế Website',
    desc: 'Website chuẩn UI/UX, chuẩn SEO, responsive đa thiết bị. Giao diện đẹp, tốc độ nhanh.',
    link: '/thiet-ke-website',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: 'Thiết Kế Mobile App',
    desc: 'Phát triển ứng dụng iOS & Android với trải nghiệm người dùng xuất sắc.',
    link: '/dich-vu',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: 'Dịch Vụ SEO',
    desc: 'Tối ưu hóa công cụ tìm kiếm, đưa website lên top Google bền vững.',
    link: '/dich-vu',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Quản Trị Website',
    desc: 'Duy trì, cập nhật và tối ưu website liên tục để đảm bảo hoạt động ổn định.',
    link: '/dich-vu',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>`,
    title: 'Quảng Cáo Google & Facebook',
    desc: 'Chiến lược quảng cáo hiệu quả, tối ưu chi phí và tăng chuyển đổi.',
    link: '/dich-vu',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Hosting & Domain',
    desc: 'Dịch vụ hosting tốc độ cao, bảo mật, uptime 99.9% cùng domain uy tín.',
    link: '/dich-vu',
  },
];
---

<section class="section" style="background:var(--bg-light);position:relative;overflow:hidden;">
  <!-- Blob background -->
  <div style="position:absolute;top:-100px;left:-200px;width:600px;height:600px;pointer-events:none;opacity:0.5;">
    <svg viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
      <path d="M 300,58 C 385,58 456,142 478,226 C 500,310 480,408 420,460 C 360,512 260,510 200,460 C 140,410 116,322 130,238 C 144,154 215,58 300,58 Z" fill="var(--teal)" opacity="0.1"/>
    </svg>
  </div>

  <div class="container" style="position:relative;z-index:1;">

    <!-- Header -->
    <div style="text-align:center;margin-bottom:56px;">
      <div data-animate class="label-tag" style="margin-bottom:12px;">DỊCH VỤ CỦA CHÚNG TÔI</div>
      <h2 data-animate data-delay="2" class="section-title">
        Giải Pháp <span>Toàn Diện</span> Cho Doanh Nghiệp
      </h2>
      <p data-animate data-delay="3" style="color:var(--text-mid);max-width:560px;margin:16px auto 0;font-size:15px;">
        Không chỉ thiết kế web, Miko Tech với hệ sinh thái các giải pháp Marketing toàn diện là điểm tựa vững chắc giúp doanh nghiệp phát triển lâu dài và bền vững.
      </p>
    </div>

    <!-- Services Grid -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {services.map((s, i) => (
        <a href={s.link}
           class="card"
           data-animate
           data-delay={String(i % 3 + 1)}
           style="padding:36px 28px;text-decoration:none;display:block;">
          <div style="width:60px;height:60px;background:var(--teal-light);border-radius:16px;display:flex;align-items:center;justify-content:center;color:var(--teal);margin-bottom:20px;transition:all 0.3s;">
            <Fragment set:html={s.icon} />
          </div>
          <h3 style="font-size:17px;font-weight:700;color:var(--text-dark);margin-bottom:10px;">{s.title}</h3>
          <p style="font-size:14px;color:var(--text-mid);line-height:1.7;">{s.desc}</p>
          <div style="margin-top:20px;color:var(--teal);font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px;">
            Tìm hiểu thêm
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 1024px) {
    .section > .container > div:last-child {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 640px) {
    .section > .container > div:last-child {
      grid-template-columns: 1fr !important;
    }
  }
</style>
